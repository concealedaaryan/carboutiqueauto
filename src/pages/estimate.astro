---
import SiteLayout from '../layouts/SiteLayout.astro';
import BookingCalculator from '../components/BookingCalculator.astro';
---
<SiteLayout title="Estimate" description="Build a live Crest Automotive treatment estimate by vehicle category, service and optional protection add-ons." currentPath="/estimate" pageNumber="08" pageLabel="Instant estimate">
  <section class="estimate-hero">
    <div class="estimate-intro"><span class="eyebrow"><i></i>08 / Instant estimate</span><h1>Book with<br /><span>precision.</span></h1><p>Choose your vehicle, select a treatment, and add protection upgrades. Your estimate updates instantly using the resident pricing catalogue.</p></div>
    <div class="estimate-note" aria-label="Three steps to build your estimate">
      <div class="estimate-step"><span>01</span><div><strong>Choose</strong><small>Vehicle category + core service</small></div></div>
      <div class="estimate-step"><span>02</span><div><strong>Upgrade</strong><small>PPF, leather or ceramic protection</small></div></div>
      <div class="estimate-step"><span>03</span><div><strong>Enquire</strong><small>Send the estimate to Crest</small></div></div>
    </div>
  </section>
  <section class="calculator-section"><div class="calculator-intro"><span class="eyebrow">Configure your care</span><h2>One clear plan.<br /><span>Built for your car.</span></h2><p>No account is required. Start with the two required choices; optional upgrades appear when useful.</p></div><BookingCalculator /></section>
  <section class="estimate-disclaimer"><div><span class="eyebrow">Before you book</span><h2>Estimate first.<br /><span>Confirm together.</span></h2></div><div><p>The calculator provides an indicative resident estimate. Crest confirms the final vehicle category, condition, treatment scope, availability, tax and booking terms before work begins.</p><a class="text-action" href="/services">Review all services <span>→</span></a></div></section>
</SiteLayout>
<style>
  .estimate-hero,.calculator-section,.estimate-disclaimer{max-width:1440px;margin:0 auto;padding:120px 80px}.estimate-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,.65fr);gap:120px;align-items:center;min-height:590px}.eyebrow{display:flex;align-items:center;gap:10px;color:#3b82f6;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.eyebrow i{display:inline-block;width:32px;height:1px;background:#3b82f6}.estimate-intro h1{margin:20px 0 24px;color:#fff;font-size:clamp(48px,5.8vw,76px);font-weight:700;line-height:1.1;letter-spacing:-.04em}.estimate-intro h1 span,.estimate-disclaimer h2 span,.calculator-intro h2 span{color:#bec6e0}.estimate-intro p{max-width:590px;margin:0;color:#c6c6cd;font-size:18px;line-height:1.6}.estimate-note{display:grid;gap:0;border:1px solid rgba(198,198,205,.16);border-radius:.5rem;background:rgba(255,255,255,.045);backdrop-filter:blur(20px);box-shadow:inset 1px 1px rgba(255,255,255,.08)}.estimate-step{display:grid;grid-template-columns:42px 1fr;gap:18px;align-items:start;padding:25px 28px;border-bottom:1px solid rgba(198,198,205,.14)}.estimate-step:last-child{border-bottom:0}.estimate-step>span{color:#3b82f6;font-size:12px;font-weight:600}.estimate-step strong,.estimate-step small{display:block}.estimate-step strong{color:#fff;font-size:18px;font-weight:600}.estimate-step small{margin-top:6px;color:#c6c6cd;font-size:14px;line-height:1.45}.calculator-section{max-width:none;background:#1b1b1d}.calculator-intro{max-width:1440px;margin:0 auto 44px}.calculator-intro h2{margin:14px 0 16px;color:#fff;font-size:clamp(32px,4vw,48px);font-weight:600;line-height:1.2;letter-spacing:-.035em}.calculator-intro p{max-width:560px;margin:0;color:#c6c6cd;font-size:16px;line-height:1.6}.calculator-section>.calculator-shell{max-width:1440px;margin:0 auto}.estimate-disclaimer{display:grid;grid-template-columns:1fr 1fr;gap:120px;align-items:end}.estimate-disclaimer h2{margin:14px 0 0;color:#fff;font-size:clamp(32px,4vw,48px);font-weight:600;line-height:1.2;letter-spacing:-.035em}.estimate-disclaimer p{max-width:570px;margin:0;color:#c6c6cd;font-size:16px;line-height:1.6}.text-action{display:inline-flex;gap:10px;margin-top:24px;color:#bec6e0;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.text-action:hover{color:#fff}@media(max-width:900px){.estimate-hero,.estimate-disclaimer{grid-template-columns:1fr;gap:48px}.estimate-hero,.calculator-section,.estimate-disclaimer{padding:90px 32px}.estimate-disclaimer{gap:24px}}@media(max-width:620px){.estimate-hero,.calculator-section,.estimate-disclaimer{padding:72px 20px}.estimate-hero{min-height:auto;padding-top:102px}.estimate-intro h1{font-size:42px}.estimate-intro p{font-size:16px}.estimate-step{padding:22px 20px}.calculator-intro{margin-bottom:30px}.calculator-intro p{font-size:14px}.estimate-disclaimer p{font-size:14px}}
</style>
