---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Crest Automotive Care — The Garage Experience" description="Explore Crest Automotive Care through a sequential, lazy-loaded garage video carousel." currentPath="/">
  <div class="garage-carousel" data-garage-carousel>
    <div class="garage-carousel-frame" aria-hidden="true"><img class="garage-carousel-image" data-carousel-image src="/garage-assets/landing-jpeg.jpeg" alt="" /><video class="garage-carousel-video" data-carousel-video muted playsinline preload="none"></video><div class="garage-carousel-shade"></div><div class="garage-carousel-meta"><span class="garage-live-dot"></span><span data-carousel-location>Entrance</span><i></i><span data-carousel-count>01 / 05</span></div></div>
    <div class="garage-carousel-steps">
      <section id="station-01" class="garage-carousel-step is-active" data-station="01" data-station-name="Entrance" data-image="/garage-assets/landing-jpeg.jpeg" data-video="/garage-assets/landing-intro.mp4"><div class="garage-liquid-card garage-intro-card"><p class="garage-kicker">Crest Automotive Care · DLF Gurugram</p><h1>Walk into<br /><em>the garage.</em></h1><p>A sequential studio tour. Scroll slowly; each film loads only when you arrive.</p><a class="garage-button" href="#station-02">Start the tour <b>↓</b></a></div></section>
      <section id="station-02" class="garage-carousel-step" data-station="02" data-station-name="Rodim PPF wall" data-image="/garage-assets/ppf-wall-jpeg.jpeg" data-video="/garage-assets/ppf-wall-animation-mp4.mp4"><div class="garage-liquid-card"><p class="garage-kicker">Left wall · PPF_WALL_ANIMATION</p><h2>Protection,<br /><em>drawn tight.</em></h2><p>The left wall opens with the PPF animation, then stays on the mapped PPF wall image. No other film is requested until you continue.</p><button class="garage-button" data-open-service="ppf">Play PPF application <b>↗</b></button></div></section>
      <section id="station-03" class="garage-carousel-step" data-station="03" data-station-name="Ceramic coating wall" data-image="/garage-assets/ceramic-coating-jpeg.jpeg" data-video="/garage-assets/ceramic-coating-video-mp4.mp4"><div class="garage-liquid-card"><p class="garage-kicker">Right wall · ceramic_coating_video</p><h2>Make the light<br /><em>stay longer.</em></h2><p>Depth, slickness and a controlled coating finish. The ceramic film is fetched when this step enters the viewport.</p><button class="garage-button" data-open-service="ceramic">Play ceramic film <b>↗</b></button></div></section>
      <section id="station-04" class="garage-carousel-step" data-station="04" data-station-name="Wash services wall" data-image="/garage-assets/service-wall-water-wash-etc-jpeg.jpeg" data-video="/garage-assets/car-wash-services-wall-mp4.mp4"><div class="garage-liquid-card"><p class="garage-kicker">Back wall · car_wash_services_wall</p><h2>Reset the<br /><em>whole car.</em></h2><p>Foam, wash, interior care and the owner-level check. The wash film is loaded only when this scene becomes active.</p><button class="garage-button" data-open-service="wash">Play wash film <b>↗</b></button></div></section>
      <section id="station-05" class="garage-carousel-step" data-station="05" data-station-name="Reception" data-image="/garage-assets/reception-jpeg.jpeg" data-video="/garage-assets/receptioionvid-mp4.mp4"><div class="garage-liquid-card"><p class="garage-kicker">Reception · receptionvid</p><h2>Leave it with<br /><em>Crest.</em></h2><p>Private consultations at DLF The Camellias, DLF Crest and DLF The Magnolias.</p><a class="garage-button" href="/contact">Plan your visit <b>↗</b></a></div></section>
    </div>
    <div class="garage-carousel-progress"><span data-carousel-progress></span></div>
    <div class="garage-carousel-modal" data-garage-modal aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="garage-modal-title"><button class="garage-modal-backdrop" data-close-modal aria-label="Close service film"></button><div class="garage-modal-dialog"><div class="garage-modal-top"><span id="garage-modal-title" data-modal-title>Service film</span><button class="garage-modal-close" data-close-modal aria-label="Close service film">×</button></div><video data-modal-video controls playsinline preload="none"></video></div></div>
  </div>
</SiteLayout>

<script>
  // @ts-nocheck
  document.body.classList.add('garage-home');
  const carousel = document.querySelector('[data-garage-carousel]'); const steps = [...document.querySelectorAll('.garage-carousel-step')]; const frameImage = document.querySelector('[data-carousel-image]'); const frameVideo = document.querySelector('[data-carousel-video]'); const locationText = document.querySelector('[data-carousel-location]'); const countText = document.querySelector('[data-carousel-count]'); const progress = document.querySelector('[data-carousel-progress]'); const modal = document.querySelector('[data-garage-modal]'); const modalVideo = modal?.querySelector('[data-modal-video]'); const modalTitle = modal?.querySelector('[data-modal-title]'); let active = null; let activeIndex = 0; let advanceTimer = 0; let lastFocused = null;
  const films = { ppf: ['/garage-assets/ppf-appliacatio-video-mp4.mp4', 'PPF application'], ceramic: ['/garage-assets/ceramic-coating-video-mp4.mp4', 'Ceramic coating'], wash: ['/garage-assets/car-foam-wash-video-mp4.mp4', 'Foam wash'] };
  frameVideo.muted = true; frameVideo.defaultMuted = true; frameVideo.setAttribute('muted', ''); frameVideo.setAttribute('playsinline', ''); frameVideo.setAttribute('webkit-playsinline', '');
  frameVideo.addEventListener('loadeddata', () => frameVideo.classList.add('is-playing'));
  frameVideo.addEventListener('error', () => { frameVideo.classList.remove('is-playing'); if (active) frameImage.src = active.dataset.image; window.clearTimeout(advanceTimer); advanceTimer = window.setTimeout(advance, 2500); });
  let transitionToken = 0;
  const releaseVideo = () => { frameVideo.pause(); frameVideo.removeAttribute('src'); frameVideo.load(); frameVideo.classList.remove('is-playing'); };
  const startVideo = () => { if (!frameVideo.src || document.hidden) return; frameVideo.muted = true; const playAttempt = frameVideo.play(); if (playAttempt?.catch) playAttempt.then(() => frameVideo.classList.add('is-playing')).catch(() => frameVideo.classList.add('is-playing')); };
  const activate = (step, index = steps.indexOf(step)) => { if (!step || step === active && frameVideo.src) return; const token = ++transitionToken; window.clearTimeout(advanceTimer); active = step; activeIndex = index < 0 ? 0 : index; steps.forEach(item => item.classList.toggle('is-active', item === step)); frameImage.src = step.dataset.image; locationText.textContent = step.dataset.stationName; countText.textContent = `${step.dataset.station} / 05`; progress.style.width = `${((activeIndex + 1) / steps.length) * 100}%`; releaseVideo(); const src = step.dataset.video; if (src) { frameVideo.preload = 'auto'; frameVideo.src = src; frameVideo.load(); frameVideo.addEventListener('ended', advance, { once: true }); frameVideo.addEventListener('canplay', startVideo, { once: true }); startVideo(); advanceTimer = window.setTimeout(() => { if (token === transitionToken) advance(); }, Number(step.dataset.duration || 6500)); } };
  const advance = () => { const nextIndex = (activeIndex + 1) % steps.length; activate(steps[nextIndex], nextIndex); };
  activate(steps[0], 0);
  document.addEventListener('visibilitychange', () => { if (!document.hidden && active) startVideo(); });
  const textObserver = new IntersectionObserver(entries => entries.forEach(entry => entry.target.classList.toggle('is-card-inview', entry.isIntersecting)), { threshold: .28 }); steps.forEach(step => textObserver.observe(step));
  document.querySelectorAll('[data-station-link]').forEach(link => link.addEventListener('click', () => { const target = document.querySelector(link.getAttribute('href')); const index = steps.indexOf(target); if (index >= 0) activate(target, index); }));
  const openModal = key => { const film = films[key] || ['/garage-assets/car-interior-detailing-process-20260910162758-mp4.mp4', 'Interior cleaning']; lastFocused = document.activeElement; modalTitle.textContent = film[1]; modalVideo.src = film[0]; modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); document.body.classList.add('garage-modal-open'); modalVideo.load(); modalVideo.play().catch(() => {}); modal.querySelector('.garage-modal-close')?.focus(); }; const closeModal = () => { modalVideo.pause(); modalVideo.removeAttribute('src'); modalVideo.load(); modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); document.body.classList.remove('garage-modal-open'); lastFocused?.focus?.(); }; document.querySelectorAll('[data-open-service]').forEach(button => button.addEventListener('click', () => openModal(button.dataset.openService))); document.querySelectorAll('[data-close-modal]').forEach(button => button.addEventListener('click', closeModal)); document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal?.classList.contains('is-open')) closeModal(); });
</script>

<style>
  :global(body){background:#05080c}.garage-carousel{position:relative;background:#05080c;color:#fff}.garage-carousel-frame{position:sticky;z-index:0;top:0;height:100svh;min-height:620px;overflow:hidden;background:#000}.garage-carousel-image,.garage-carousel-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.garage-carousel-image{z-index:0}.garage-carousel-video{z-index:1;opacity:0;transition:opacity .8s ease}.garage-carousel-video.is-playing{opacity:1}.garage-carousel-shade{position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,rgba(2,7,12,.88),rgba(2,7,12,.2) 60%,rgba(2,7,12,.56)),linear-gradient(0deg,rgba(2,7,12,.86),transparent 55%,rgba(2,7,12,.4));pointer-events:none}.garage-carousel-meta{position:absolute;z-index:4;top:30px;left:max(24px,7vw);right:max(24px,7vw);display:flex;align-items:center;gap:13px;color:#fff;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;text-shadow:0 2px 12px #000}.garage-carousel-meta i{height:1px;flex:1;background:rgba(255,255,255,.38)}.garage-live-dot{width:7px;height:7px;border-radius:50%;background:#ffd09d;box-shadow:0 0 14px #ffd09d}.garage-carousel-steps{position:relative;z-index:2;margin-top:-100svh}.garage-carousel-step{min-height:100svh;display:flex;align-items:center;padding:100px max(24px,7vw);scroll-margin-top:0}.garage-liquid-card{width:min(560px,100%);padding:30px 32px;border:1px solid rgba(255,208,157,.52);border-radius:24px;background:linear-gradient(135deg,rgba(10,19,28,.78),rgba(10,19,28,.38));box-shadow:0 24px 90px rgba(0,0,0,.35),inset 0 1px rgba(255,255,255,.2);backdrop-filter:blur(22px) saturate(1.25);transform:translateY(28px);opacity:.25;transition:opacity .5s ease,transform .6s cubic-bezier(.23,1,.32,1)}.garage-carousel-step.is-active .garage-liquid-card{opacity:1;transform:none}.garage-kicker{margin:0;color:#ffd09d;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.garage-liquid-card h1,.garage-liquid-card h2{margin:15px 0 22px;color:#fff;font-size:clamp(54px,7vw,108px);font-weight:500;letter-spacing:-.06em;line-height:.9;text-shadow:0 3px 28px #000}.garage-liquid-card em{color:#ffd09d;font-style:normal}.garage-liquid-card>p:not(.garage-kicker){max-width:440px;color:#f3f7fa;font-size:17px;line-height:1.65;text-shadow:0 2px 16px #000}.garage-button{display:inline-flex;align-items:center;gap:20px;margin-top:21px;padding:15px 18px;border:1px solid #ffd09d;color:#08121c;background:#ffd09d;font:inherit;font-size:11px;font-weight:800;letter-spacing:.1em;text-decoration:none;text-transform:uppercase;cursor:pointer}.garage-button:hover{background:#fff0d4}.garage-button b{font-size:18px;font-weight:400}.garage-carousel-progress{position:fixed;z-index:5;right:26px;top:50%;width:2px;height:150px;background:rgba(255,255,255,.25);transform:translateY(-50%)}.garage-carousel-progress span{display:block;width:100%;height:20%;background:#ffd09d;transition:height .5s ease}.garage-carousel-modal{position:fixed;z-index:200;inset:0;display:grid;place-items:center;padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease}.garage-carousel-modal.is-open{opacity:1;visibility:visible;pointer-events:auto}.garage-modal-backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.9)}.garage-modal-dialog{position:relative;z-index:1;width:min(900px,100%);border:1px solid rgba(255,208,157,.6);background:#070707}.garage-modal-top{display:flex;justify-content:space-between;align-items:center;padding:15px 18px;color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.garage-modal-close{width:34px;height:34px;border:1px solid rgba(255,255,255,.35);border-radius:50%;color:#fff;background:transparent;font-size:24px;cursor:pointer}.garage-modal-dialog>video{display:block;width:100%;aspect-ratio:16/9;background:#000}.garage-modal-open{overflow:hidden}
  @media(max-width:760px){.garage-carousel-frame{height:calc(100svh - 72px);min-height:550px}.garage-carousel-steps{margin-top:calc(-100svh + 72px)}.garage-carousel-step{min-height:calc(100svh - 72px);padding:88px 20px}.garage-liquid-card{padding:22px 20px;border-radius:20px}.garage-liquid-card h1,.garage-liquid-card h2{font-size:clamp(48px,14vw,78px)}.garage-liquid-card>p:not(.garage-kicker){font-size:15px}.garage-carousel-progress{right:13px;height:110px}.garage-carousel-meta{top:18px;left:20px;right:20px}}
  @media(prefers-reduced-motion:reduce){.garage-liquid-card,.garage-carousel-video,.garage-carousel-modal{transition:none}}
  .garage-liquid-card,
  .garage-liquid-card * { opacity: 1 !important; color: #fff !important; -webkit-text-fill-color: #fff !important; text-shadow: 0 2px 18px rgba(0,0,0,.96) !important; }
  .garage-liquid-card { background: transparent !important; border-color: rgba(255,255,255,.7) !important; box-shadow: 0 24px 80px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.18) !important; backdrop-filter: none !important; }
  .garage-liquid-card .garage-button,
  .garage-liquid-card .garage-button:hover { color: #05080c !important; -webkit-text-fill-color: #05080c !important; background: #fff !important; border-color: #fff !important; text-shadow: none !important; }
  .garage-liquid-card .garage-kicker { font-weight: 800 !important; letter-spacing: .16em !important; }
  @media (max-width:760px) {
    :global(html), :global(body), :global(body.garage-home main) { overflow-x:visible !important; overflow-y:visible !important; }
    :global(body.garage-home main) { position:relative !important; }
    .garage-carousel { position:relative !important; display:block !important; min-height:500svh !important; height:auto !important; overflow:visible !important; background:#05080c !important; -webkit-overflow-scrolling:touch !important; }
    .garage-carousel-frame { position:sticky !important; top:0 !important; z-index:0 !important; display:block !important; width:100% !important; height:100vh !important; height:100svh !important; min-height:0 !important; margin:0 !important; overflow:hidden !important; background:#08131c !important; }
    .garage-carousel-steps { position:relative !important; z-index:10 !important; display:block !important; margin-top:-100vh !important; margin-top:-100svh !important; overflow:visible !important; -webkit-overflow-scrolling:touch !important; }
    .garage-carousel-step { position:relative !important; z-index:10 !important; display:flex !important; align-items:flex-end !important; width:100% !important; min-height:100vh !important; min-height:100svh !important; height:100vh !important; height:100svh !important; padding:0 16px 30px !important; box-sizing:border-box !important; pointer-events:none; }
    .garage-liquid-card { pointer-events:auto; width:100% !important; max-width:none !important; margin:0 !important; }
    .garage-carousel-image,.garage-carousel-video { width:100% !important; height:100% !important; object-fit:contain !important; object-position:50% 50% !important; background:#08131c !important; }
    .garage-carousel-image { opacity:.92 !important; }
    .garage-carousel-video { opacity:.86 !important; visibility:visible !important; }
    .garage-carousel-shade { background:linear-gradient(90deg,rgba(0,0,0,.58),rgba(0,0,0,.08) 72%,rgba(0,0,0,.34)),linear-gradient(0deg,rgba(0,0,0,.66),transparent 58%,rgba(0,0,0,.26)) !important; }
    .garage-liquid-card { background:transparent !important; border-color:rgba(255,255,255,.78) !important; backdrop-filter:none !important; }
    .garage-liquid-card h1,.garage-liquid-card h2 { text-shadow:0 3px 24px rgba(0,0,0,.98) !important; }
    .garage-liquid-card>p:not(.garage-kicker) { text-shadow:0 2px 18px rgba(0,0,0,1) !important; }
    .garage-carousel-meta { top:18px !important; }
    .garage-carousel-progress { position:fixed !important; top:50% !important; right:10px !important; }
  }
  .garage-liquid-card { transition: opacity .48s ease, transform .6s cubic-bezier(.22,1,.36,1) !important; }
  .garage-carousel-step:not(.is-card-inview) .garage-liquid-card { opacity: 0 !important; transform: translateY(34px) !important; }
  .garage-carousel-step.is-card-inview .garage-liquid-card { opacity: 1 !important; transform: translateY(0) !important; }
  @media(prefers-reduced-motion:reduce){.garage-carousel-step:not(.is-card-inview) .garage-liquid-card,.garage-carousel-step.is-card-inview .garage-liquid-card{opacity:1!important;transform:none!important}}
</style>
