ze:clamp(30px,8vw,40px)!important}h3{font-size:20px}.proof-bar{grid-template-columns:1fr}.proof-bar>div{padding:22px 20px}.trust-copy{padding:20px 0 0;border-left:0;border-top:1px solid var(--gold)}.education-section,.cars-section{padding:80px 20px}.education-image{min-height:0}.education-image img{min-height:0;height:100%;object-fit:cover}.fact-grid{grid-template-columns:1fr;gap:16px}.variant-grid{grid-template-columns:1fr}.variant-card{min-height:220px}.basf-section{display:block}.basf-copy{max-width:none}.cars-list span:nth-child(odd){margin-right:12px}.other-services{gap:20px}.home-cta{padding-top:82px;padding-bottom:90px}.cta-contact{width:auto;padding-left:20px}}
</style>
<script is:inline data-astro-rerun>
  (() => { window.__crestRevealCleanup?.(); const revealItems = document.querySelectorAll('.reveal'); const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); } }), { threshold: .12 }); revealItems.forEach((item) => revealObserver.observe(item)); window.__crestRevealCleanup = () => revealObserver.disconnect(); })();
</script>
