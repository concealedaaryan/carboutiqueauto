---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ChoiceCard from '../components/ChoiceCard.astro';
const popularServices = [
  { number: '01', eyebrow: 'Daily care', title: 'Premium waterless wash & wax', copy: 'A polished daily reset with glass cleaning and tyre polish.', price: '₹200–₹500', href: '/services#treatment-01' },
  { number: '02', eyebrow: 'Interior care', title: 'Interior cleaning (basic)', copy: 'A focused cabin refresh for dashboard, trims, mats, windows and mirrors.', price: '₹250–₹600', href: '/services#treatment-02' },
  { number: '03', eyebrow: 'Surface protection', title: 'Premium ceramic coating', copy: 'Three-year protection with correction, coating, glass care and rechecks.', price: '₹15,000–₹35,000', href: '/protection#ceramic' },
];
---
<SiteLayout title="Premium Car Care" description="Crest Automotive — premium, waterless car care for The Camellias, The Crest and The Magnolias." currentPath="/">
  <section class="home-hero" data-section="hero">
    <div class="home-copy reveal">
      <span class="eyebrow"><i></i> DLF-approved · in-house premium care</span>
      <h1>Premium care.<br /><em>A better finish.</em></h1>
      <p>Waterless automotive detailing, paint protection and thoughtful aftercare for the cars of DLF Gurugram.</p>
      <div class="hero-actions"><a class="button button-gold" href="/services">Explore services <span>↗</span></a><a class="button button-ghost" href="/estimate">Build an estimate <span>→</span></a></div>
    </div>
    <div class="home-visual reveal reveal-delay-1">
      <div class="photo-frame" style="background-image: linear-gradient(180deg, rgba(7,21,40,.04) 40%, rgba(7,21,40,.88) 100%), url('/images/crest-hero.jpg');">
        <div class="image-caption"><span>Premium automotive care</span><small>In-house detailing in DLF Gurugram</small></div>
      </div>
    </div>
  </section>
  <section class="proof-strip" aria-label="Crest Automotive proof points"><div><strong>3,15,000+</strong><span>cars cared for</span></div><div><strong>30M+</strong><span>litres of water saved</span></div><div><strong>5 AM–6 PM</strong><span>daily service window</span></div><div><strong>2021</strong><span>in-house since launch</span></div></section>
  <section class="home-section" data-section="services">
    <div class="reveal"><SectionHeading eyebrow="01 / Popular treatments" title="Start with the" accent="right service." copy="A quick introduction to our most requested treatments. The full catalogue and vehicle-category pricing live on the Services page." actionHref="/services" actionLabel="View complete catalogue" /></div>
    <div class="popular-grid">{popularServices.map((item) => <article class="popular-card reveal"><div class="card-top"><span>{item.number}</span><a href={item.href} aria-label={`View ${item.title}`}>↗</a></div><span class="eyebrow">{item.eyebrow}</span><h3>{item.title}</h3><p>{item.copy}</p><div><strong>{item.price}</strong><a href={item.href}>View details <span>→</span></a></div></article>)}</div>
    <a class="section-link reveal" href="/services">View the complete service catalogue <span>→</span></a>
  </section>
  <section class="home-paths" data-section="explore">
    <div class="reveal"><SectionHeading eyebrow="02 / Choose your next step" title="Care that fits" accent="your car." copy="Compare recurring plans, protect the finish or calculate an indicative price before you speak with the team." /></div>
    <div class="path-grid"><ChoiceCard number="01" accent="Monthly care" title="Monthly packages" copy="Make clean a recurring habit." action="Explore packages" href="/packages" /><ChoiceCard number="02" accent="Surface protection" title="Protection systems" copy="PPF, ceramic, graphene and more." action="See protection" href="/protection" /><ChoiceCard number="03" accent="Fastest route" title="Instant estimate" copy="Choose your vehicle and build a plan." action="Calculate now" href="/estimate" /></div>
  </section>
  <section class="home-cta" data-section="contact"><div class="reveal"><span class="eyebrow">03 / Ready when you are</span><h2>Tell us about<br /><em>your car.</em></h2><p>Share your model, preferred service and community. We will confirm the right treatment tier.</p><a class="button button-gold" href="/contact">Book a treatment <span>↗</span></a></div><div class="cta-contact reveal reveal-delay-1"><span>Ruchir Malhotra</span><a href="tel:+919871610952">+91 98716 10952</a><span>Ranjeev Kapoor</span><a href="tel:+919810528263">+91 98105 28263</a></div></section>
</SiteLayout>
<style>
  .home-hero, .home-section, .home-paths, .home-cta { max-width: var(--max); margin: 0 auto; padding: 124px 24px; }
  .home-hero { position: relative; display: grid; grid-template-columns: minmax(0,.92fr) minmax(390px,1.08fr); gap: 58px; align-items: center; min-height: 700px; padding-top: 154px; padding-bottom: 82px; }
  .home-hero::before { content: ''; position: absolute; z-index: -1; inset: 0 -50vw; background: radial-gradient(circle at 70% 20%, rgba(226,185,104,.10), transparent 30%), linear-gradient(120deg, #071528 35%, #0c2746 100%); }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow i { width: 34px; height: 1px; background: var(--gold); }
  h1, h2, h3 { color: var(--white); line-height: 1.08; letter-spacing: -.055em; }
  h1 { max-width: 620px; margin: 22px 0; font-size: clamp(46px, 5.5vw, 72px); }
  h1 em, h2 em { color: var(--gold-soft); font-style: normal; }
  .home-copy > p { max-width: 470px; color: var(--white); font-size: 16px; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .home-visual { min-height: 480px; }
  .photo-frame { position: relative; display: flex; min-height: 480px; flex-direction: column; justify-content: end; padding: 24px; overflow: hidden; border: 1px solid var(--line); background-size: cover; background-position: center; }
  .image-caption { position: relative; z-index: 1; display: grid; gap: 5px; }
  .image-caption span { color: var(--white); font-size: 13px; font-weight: 700; letter-spacing: .03em; }
  .image-caption small { color: var(--white); font-size: 10px; letter-spacing: .04em; }
  .proof-strip { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #0a1d35; }
  .proof-strip div { display: flex; flex-direction: column; gap: 4px; padding: 25px max(24px, calc((100vw - var(--max)) / 2)); border-right: 1px solid var(--line); }
  .proof-strip div + div { padding-left: 28px; }
  .proof-strip strong { color: var(--white); font-size: 18px; }
  .proof-strip span { color: var(--white); font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 65px; margin-bottom: 48px; }
  .section-heading h2, .home-cta h2 { margin: 14px 0 0; font-size: clamp(34px, 4vw, 52px); }
  .section-heading > p { max-width: 360px; margin: 0; color: var(--white); font-size: 15px; line-height: 1.6; }
  .popular-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .popular-card { display: flex; min-height: 300px; flex-direction: column; padding: 25px; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(226,185,104,.11), rgba(255,255,255,.025)); transition: transform .3s var(--ease), border-color .25s ease, box-shadow .25s ease; }
  .popular-card:hover, .path-card:hover { border-color: rgba(226,185,104,.72); transform: translateY(-7px); box-shadow: 0 18px 45px rgba(0,0,0,.2); }
  .card-top { display: flex; justify-content: space-between; color: var(--gold); font-size: 11px; font-weight: 700; }
  .card-top a { color: var(--gold-soft); font-size: 20px; transition: color .2s ease, transform .2s var(--ease); }
  .popular-card:hover .card-top a { color: var(--white); transform: translate(3px,-3px); }
  .popular-card .eyebrow { margin-top: 40px; color: var(--white); font-size: 9px; }
  .popular-card h3 { margin: 9px 0 12px; font-size: 21px; }
  .popular-card p { margin: 0 auto 22px; color: var(--white); font-size: 14px; line-height: 1.55; }
  .popular-card > div:last-child { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
  .popular-card strong { color: var(--white); font-size: 14px; }
  .popular-card > div a, .section-link { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .section-link { display: inline-block; margin-top: 28px; transition: color .2s ease, transform .2s var(--ease); }
  .section-link:hover { color: var(--white); transform: translateX(4px); }
  .home-paths { padding-top: 110px; padding-bottom: 110px; background: #0a1d35; }
  .path-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .path-card { display: flex; min-height: 220px; flex-direction: column; padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease, box-shadow .25s ease; }
  .path-card > span { color: var(--gold); font-size: 10px; font-weight: 700; }
  .path-card strong { margin: auto 0 5px; color: var(--white); font-size: 20px; }
  .path-card small { color: var(--white); font-size: 14px; }
  .path-card b { margin-top: 22px; color: var(--gold-soft); font-size: 10px; letter-spacing: .07em; text-transform: uppercase; }
  .home-cta { display: flex; justify-content: space-between; gap: 60px; align-items: end; border-top: 1px solid var(--line); }
  .home-cta p { max-width: 420px; margin: 24px 0 30px; color: var(--white); font-size: 15px; line-height: 1.6; }
  .cta-contact { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 30px; padding-left: 30px; border-left: 1px solid var(--line); }
  .cta-contact span { color: var(--white); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  .cta-contact a { color: var(--gold-soft); font-size: 16px; font-weight: 600; }
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: .1s; }
  .reveal-delay-2 { transition-delay: .18s; }
  @media (max-width: 900px) { .home-hero { grid-template-columns: 1fr; gap: 42px; } .home-visual { min-height: 420px; } .photo-frame { min-height: 420px; } .popular-grid, .path-grid { grid-template-columns: 1fr; } .popular-card { min-height: 260px; } .home-cta { display: block; } .cta-contact { width: max-content; margin-top: 45px; } }
  @media (max-width: 620px) { .home-hero, .home-section, .home-paths, .home-cta { padding: 82px 20px; } .home-hero { min-height: auto; padding-top: 122px; } h1 { font-size: clamp(42px, 12vw, 60px); } .home-copy > p { font-size: 15px; } .home-visual, .photo-frame { min-height: 320px; } .proof-strip { grid-template-columns: 1fr 1fr; } .proof-strip div, .proof-strip div + div { padding: 18px 20px; } .proof-strip strong { font-size: 16px; } .section-heading { display: block; margin-bottom: 34px; } .section-heading > p { margin-top: 20px; } .cta-contact { grid-template-columns: 1fr; width: auto; padding-left: 20px; } }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }
</style>
<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
    window.__crestRevealCleanup?.();
    const revealItems = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); } }), { threshold: .12 });
    revealItems.forEach((item) => revealObserver.observe(item));
    window.__crestRevealCleanup = () => revealObserver.disconnect();
  })();
</script>
