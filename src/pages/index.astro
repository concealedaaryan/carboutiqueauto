---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ChoiceCard from '../components/ChoiceCard.astro';
import ProofStrip from '../components/ProofStrip.astro';
import ImageCard from '../components/ImageCard.astro';

const popularServices = [
  { number: '01', eyebrow: 'Daily care', title: 'Premium waterless wash & wax', copy: 'A polished daily reset with glass cleaning and tyre polish.', price: '₹200–₹500', href: '/services#treatment-01' },
  { number: '02', eyebrow: 'Interior care', title: 'Interior cleaning', copy: 'A focused cabin refresh for dashboard, trims, mats, windows and mirrors.', price: '₹250–₹600', href: '/services#treatment-02' },
  { number: '03', eyebrow: 'Surface protection', title: 'Premium ceramic coating', copy: 'Three-year protection with correction, coating, glass care and rechecks.', price: '₹15,000–₹35,000', href: '/protection#ceramic' },
];
const stats = [
  { value: '3,15,000+', label: 'cars cared for', detail: 'A long record of considered finishes.' },
  { value: '30M+', label: 'litres of water saved', detail: 'Waterless care, built for the city.' },
  { value: '5 AM–6 PM', label: 'daily service window', detail: 'Care that fits your schedule.' },
  { value: '2021', label: 'in-house since launch', detail: 'A private studio for DLF Gurugram.' },
];
---
<SiteLayout title="Premium Car Detailing in DLF Gurugram" description="Crest Automotive is a premium car detailing studio serving The Camellias, The Crest and The Magnolias in DLF Gurugram. Build a care plan for your car." currentPath="/">
  <section class="hero-shell" data-section="hero">
    <div class="hero-copy reveal">
      <span class="eyebrow"><i></i> Private automotive care · DLF Gurugram</span>
      <h1>The finish<br /><em>you notice.</em></h1>
      <p>Waterless detailing, paint protection and thoughtful aftercare for the cars of The Camellias, The Crest and The Magnolias.</p>
      <div class="hero-actions"><a class="button button-gold" href="/estimate">Build your care plan <span>↗</span></a><a class="text-action" href="/services">Explore services <span>→</span></a></div>
      <div class="hero-note"><span class="hero-note-mark">C</span><div><strong>In-house. Considered. Local.</strong><small>Premium care without leaving your community.</small></div></div>
    </div>
    <div class="hero-media reveal reveal-delay-1"><img src="/images/generated/crest-hero-studio.jpg" alt="Graphite luxury sedan in Crest Automotive's dark detailing studio" width="2560" height="1440" fetchpriority="high" decoding="async" /><div class="hero-media-caption"><span>01 / Studio finish</span><small>Graphite sedan · private detailing bay</small></div></div>
  </section>
  <ProofStrip stats={stats} />
  <section class="home-section" data-section="services">
    <div class="reveal"><SectionHeading eyebrow="01 / Start here" title="Choose the" accent="right level of care." copy="You do not need to know the technical terms. Begin with what your car needs today, then we will help you decide what comes next." actionHref="/services" actionLabel="See every service" /></div>
    <div class="popular-grid">{popularServices.map((item) => <article class="popular-card reveal"><div class="card-top"><span>{item.number}</span><a href={item.href} aria-label={`View ${item.title}`}>↗<span class="sr-only">View {item.title}</span></a></div><span class="eyebrow">{item.eyebrow}</span><h3>{item.title}</h3><p>{item.copy}</p><div><strong>{item.price}</strong><a href={item.href}>View details <span>→</span></a></div></article>)}</div>
  </section>
  <section class="editorial-band">
    <div class="editorial-grid">
      <ImageCard src="/images/generated/crest-detailing-process.jpg" alt="Crest technician carefully finishing graphite automotive paint with a microfiber cloth" eyebrow="The Crest standard" title="Precision you can see." caption="Every pass is deliberate." />
      <div class="editorial-copy reveal"><span class="eyebrow">02 / Why Crest</span><h2>Quietly obsessive<br /><em>about the details.</em></h2><p>We keep the experience simple for you and exact for the car. Clear recommendations, careful hands and a finish that feels right long after you leave.</p><a class="text-action" href="/why-crest">See how we work <span>→</span></a><div class="editorial-points"><span><b>01</b> Waterless process</span><span><b>02</b> Trained specialists</span><span><b>03</b> Community-first service</span></div></div>
    </div>
  </section>
  <section class="home-paths" data-section="explore">
    <div class="reveal"><SectionHeading eyebrow="03 / Choose your next step" title="Care that fits" accent="your car." copy="A monthly rhythm, long-term protection or a quick estimate. Pick the route that feels easiest." /></div>
    <div class="path-grid"><ChoiceCard number="01" accent="Monthly care" title="Packages" copy="Make clean a recurring habit." action="Explore packages" href="/packages" /><ChoiceCard number="02" accent="Surface protection" title="Protection" copy="PPF, ceramic, graphene and more." action="See protection" href="/protection" /><ChoiceCard number="03" accent="Fastest route" title="Instant estimate" copy="Choose your vehicle and build a plan." action="Calculate now" href="/estimate" /></div>
  </section>
  <section class="image-proof-band"><ImageCard src="/images/generated/crest-ceramic-beading.jpg" alt="Water beads on a dark car paint surface after ceramic coating" eyebrow="Protection in practice" title="The finish stays ready." caption="Ceramic coating · water beading detail" href="/protection#ceramic" /><div class="image-proof-copy reveal"><span class="eyebrow">04 / Protection</span><h2>More time enjoying<br /><em>the car.</em></h2><p>Protection is not just about the first reveal. It is about making every clean easier, every reflection deeper and every drive feel more considered.</p><a class="button button-gold" href="/protection">Explore protection <span>↗</span></a></div></section>
  <section class="home-cta" data-section="contact"><div class="reveal"><span class="eyebrow">05 / Ready when you are</span><h2>Tell us about<br /><em>your car.</em></h2><p>Share your model, preferred service and community. We will confirm the right treatment tier and next available slot.</p><a class="button button-gold" href="/contact">Request an appointment <span>↗</span></a></div><div class="cta-contact reveal reveal-delay-1"><span>Talk directly</span><a href="tel:+919871610952">+91 98716 10952</a><span>WhatsApp concierge</span><a href="https://wa.me/919871610952" target="_blank" rel="noreferrer">Message the team ↗</a></div></section>
</SiteLayout>
<style>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hero-shell,.home-section,.editorial-band,.home-paths,.image-proof-band,.home-cta{max-width:var(--max);margin:0 auto;padding:110px 24px}.hero-shell{display:grid;grid-template-columns:minmax(0,.82fr) minmax(430px,1.18fr);gap:65px;align-items:center;min-height:720px;padding-top:155px}.hero-shell::before{content:'';position:absolute;z-index:-1;inset:84px 0 auto;height:650px;background:radial-gradient(circle at 78% 34%,rgba(59,130,246,.12),transparent 30%),linear-gradient(115deg,#131315 30%,#0b2038 100%)}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--gold);font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.eyebrow i{display:inline-block;width:31px;height:1px;background:var(--gold)}h1,h2,h3{color:var(--white);line-height:1.04;letter-spacing:-.06em}h1{margin:20px 0 23px;font-size:clamp(54px,6.9vw,96px)}h1 em,h2 em{color:var(--gold-soft);font-style:normal}.hero-copy>p{max-width:470px;color:var(--white);font-size:16px;line-height:1.7}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:22px;margin-top:34px}.text-action{display:inline-flex;align-items:center;gap:10px;color:var(--gold-soft);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.text-action:hover{color:var(--white)}.hero-media{position:relative;min-height:540px;overflow:hidden;border:1px solid rgba(59,130,246,.32);background:var(--panel)}.hero-media::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 54%,rgba(19,19,21,.78) 100%)}.hero-media img{display:block;width:100%;height:540px;object-fit:cover}.hero-media-caption{position:absolute;z-index:1;right:25px;bottom:22px;left:25px;display:flex;justify-content:space-between;gap:20px;align-items:end}.hero-media-caption span{color:var(--gold);font-size:9px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.hero-media-caption small{color:var(--white);font-size:10px}.hero-note{display:flex;align-items:center;gap:11px;margin-top:36px}.hero-note-mark{display:grid;place-items:center;width:27px;height:27px;border:1px solid var(--gold);color:var(--gold);font-size:12px;font-weight:700;transform:skew(-10deg)}.hero-note strong,.hero-note small{display:block}.hero-note strong{color:var(--white);font-size:11px}.hero-note small{margin-top:2px;color:var(--white);font-size:10px}.home-section{padding-top:125px}.popular-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.popular-card{display:flex;min-height:320px;flex-direction:column;padding:26px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(59,130,246,.11),rgba(255,255,255,.025));transition:transform .3s var(--ease),border-color .25s ease,box-shadow .25s ease}.popular-card:hover{border-color:rgba(59,130,246,.72);transform:translateY(-7px);box-shadow:0 18px 45px rgba(0,0,0,.2)}.card-top{display:flex;justify-content:space-between;color:var(--gold);font-size:11px;font-weight:700}.card-top a{color:var(--gold-soft);font-size:20px}.popular-card .eyebrow{margin-top:50px;color:var(--white);font-size:9px}.popular-card h3{margin:9px 0 12px;font-size:22px}.popular-card p{margin:0 auto 22px;color:var(--white);font-size:14px;line-height:1.55}.popular-card>div:last-child{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:auto;padding-top:16px;border-top:1px solid var(--line)}.popular-card strong{color:var(--white);font-size:14px}.popular-card>div a{color:var(--gold-soft);font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.editorial-band{max-width:none;background:#1b1b1d}.editorial-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:72px;max-width:var(--max);margin:0 auto;align-items:center}.editorial-grid .image-card{min-height:470px}.editorial-grid .image-card img{min-height:470px}.editorial-copy h2,.image-proof-copy h2,.home-cta h2{margin:16px 0 20px;font-size:clamp(38px,4.8vw,62px)}.editorial-copy>p,.image-proof-copy>p,.home-cta p{max-width:430px;color:var(--white);font-size:15px;line-height:1.7}.editorial-points{display:grid;gap:14px;margin-top:38px;padding-top:25px;border-top:1px solid var(--line)}.editorial-points span{color:var(--white);font-size:11px;text-transform:uppercase;letter-spacing:.09em}.editorial-points b{display:inline-block;width:31px;color:var(--gold);font-size:10px}.home-paths{max-width:none;padding-top:120px;padding-bottom:120px;background:linear-gradient(135deg,#0b2038,#1b1b1d)}.home-paths>.section-heading,.path-grid{max-width:var(--max);margin-right:auto;margin-left:auto}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.image-proof-band{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.image-proof-band .image-card{min-height:390px}.image-proof-band .image-card img{min-height:390px}.home-cta{display:flex;justify-content:space-between;align-items:end;gap:60px;border-top:1px solid var(--line)}.cta-contact{display:grid;grid-template-columns:1fr 1fr;gap:8px 30px;padding-left:30px;border-left:1px solid var(--line)}.cta-contact span{color:var(--white);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.cta-contact a{color:var(--gold-soft);font-size:16px;font-weight:600}.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease),transform .7s var(--ease)}.reveal.is-visible{opacity:1;transform:none}.reveal-delay-1{transition-delay:.1s}.reveal-delay-2{transition-delay:.18s}@media(max-width:900px){.hero-shell{grid-template-columns:1fr;gap:40px}.hero-media,.hero-media img{min-height:430px;height:430px}.popular-grid,.path-grid,.editorial-grid,.image-proof-band{grid-template-columns:1fr}.editorial-grid{gap:42px}.editorial-grid .image-card,.editorial-grid .image-card img{min-height:360px}.home-cta{display:block}.cta-contact{width:max-content;margin-top:45px}}@media(max-width:620px){.hero-shell,.home-section,.editorial-band,.home-paths,.image-proof-band,.home-cta{padding:82px 20px}.hero-shell{padding-top:122px}.hero-media,.hero-media img{min-height:320px;height:320px}.hero-media-caption{display:grid;gap:4px}.hero-shell h1{font-size:clamp(52px,14vw,70px)}.hero-copy>p{font-size:15px}.popular-grid{gap:11px}.popular-card{min-height:275px;padding:22px}.editorial-grid .image-card,.editorial-grid .image-card img,.image-proof-band .image-card,.image-proof-band .image-card img{min-height:300px}.cta-contact{grid-template-columns:1fr;width:auto;padding-left:20px}.home-paths{padding-top:88px;padding-bottom:88px}}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
</style>
<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => { window.__crestRevealCleanup?.(); const revealItems=document.querySelectorAll('.reveal'); const revealObserver=new IntersectionObserver((entries)=>entries.forEach((entry)=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target)}}),{threshold:.12}); revealItems.forEach((item)=>revealObserver.observe(item)); window.__crestRevealCleanup=()=>revealObserver.disconnect(); })();
</script>
