---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Crest Automotive Care — The Garage Experience" description="Walk through Crest Automotive Care's premium detailing garage in a five-scene video experience." currentPath="/">
  <div class="garage-experience" data-garage-experience>
    <section id="station-01" class="garage-scene garage-intro is-current" data-scene="intro" data-station="01" data-station-name="Entrance" data-duration="5000">
      <video class="garage-scene-video" autoplay muted playsinline preload="auto"><source src="/garage-assets/landing-intro.mp4" type="video/mp4" /></video><div class="garage-black-fade"></div><div class="garage-intro-copy"><p>Crest Automotive Care</p><span>DLF Gurugram</span></div><div class="garage-scroll-indicator"><span>Scroll to enter</span><b>↓</b></div>
    </section>

    <section id="station-02" class="garage-scene garage-wall-scene" data-scene="ppf" data-station="02" data-station-name="Rodim PPF wall" data-duration="6500">
      <img class="garage-static-image" src="/garage-assets/ppf-wall-jpeg.jpeg" alt="Rodim PPF wall" loading="lazy" /><video class="garage-scene-video" muted playsinline preload="none" poster="/garage-assets/ppf-wall-jpeg.jpeg"><source src="/garage-assets/ppf-wall-animation-mp4.mp4" type="video/mp4" /></video><div class="garage-black-fade"></div><div class="garage-wall-copy"><p class="garage-kicker">Left wall · Rodim PPF</p><h1>Protection,<br /><em>drawn tight.</em></h1><p>Precision paint protection film for the panels that take the most from the road.</p><button class="garage-button" data-open-service="ppf">Play PPF film <b>↗</b></button></div><div class="garage-scene-state">02 <span>/ 05</span></div>
    </section>

    <section id="station-03" class="garage-scene garage-wall-scene" data-scene="ceramic" data-station="03" data-station-name="Ceramic coating wall" data-duration="6500">
      <img class="garage-static-image" src="/garage-assets/ceramic-coating-jpeg.jpeg" alt="Ceramic coating wall" loading="lazy" /><video class="garage-scene-video" muted playsinline preload="none" poster="/garage-assets/ceramic-coating-jpeg.jpeg"><source src="/garage-assets/ceramic-coating-video-mp4.mp4" type="video/mp4" /></video><div class="garage-black-fade"></div><div class="garage-wall-copy"><p class="garage-kicker">Right wall · Ceramic coating</p><h1>Make the light<br /><em>stay longer.</em></h1><p>Coating work for depth, slickness and a finish that keeps its composure under the studio lights.</p><button class="garage-button" data-open-service="ceramic">Play coating film <b>↗</b></button></div><div class="garage-scene-state">03 <span>/ 05</span></div>
    </section>

    <section id="station-04" class="garage-scene garage-wall-scene" data-scene="services" data-station="04" data-station-name="Wash bay" data-duration="6500">
      <img class="garage-static-image" src="/garage-assets/service-wall-water-wash-etc-jpeg.jpeg" alt="Wash services wall" loading="lazy" /><video class="garage-scene-video" muted playsinline preload="none" poster="/garage-assets/service-wall-water-wash-etc-jpeg.jpeg"><source src="/garage-assets/car-wash-services-wall-mp4.mp4" type="video/mp4" /></video><div class="garage-black-fade"></div><div class="garage-wall-copy"><p class="garage-kicker">Back wall · Wash bay</p><h1>Reset the<br /><em>whole car.</em></h1><p>Waterless wash, foam work, interior cleaning and the final owner-level check.</p><button class="garage-button" data-open-service="wash">Play wash film <b>↗</b></button></div><div class="garage-scene-state">04 <span>/ 05</span></div>
    </section>

    <section id="station-05" class="garage-scene garage-wall-scene" data-scene="reception" data-station="05" data-station-name="Reception" data-duration="7000">
      <img class="garage-static-image" src="/garage-assets/reception-jpeg.jpeg" alt="Crest Automotive Care reception" loading="lazy" /><video class="garage-scene-video" muted playsinline preload="none" poster="/garage-assets/reception-jpeg.jpeg"><source src="/garage-assets/receptioionvid-mp4.mp4" type="video/mp4" /></video><div class="garage-black-fade"></div><div class="garage-wall-copy"><p class="garage-kicker">Through the door · Reception</p><h1>Leave it with<br /><em>Crest.</em></h1><p>Private consultations at DLF The Camellias, DLF Crest and DLF The Magnolias.</p><a class="garage-button" href="/contact">Plan your visit <b>↗</b></a></div><div class="garage-scene-state">05 <span>/ 05</span></div></section>

    <div class="garage-modal" data-garage-modal aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="garage-modal-title"><button class="garage-modal-backdrop" data-close-modal aria-label="Close service film"></button><div class="garage-modal-dialog"><div class="garage-modal-top"><span id="garage-modal-title" data-modal-title>Service film</span><button class="garage-modal-close" data-close-modal aria-label="Close service film">×</button></div><div class="garage-modal-video"><video data-modal-video controls playsinline preload="metadata"></video></div><p class="garage-modal-caption" data-modal-caption></p></div></div>
  </div>
</SiteLayout>

<script>
  // @ts-nocheck
  const scenes = [...document.querySelectorAll('.garage-scene')]; const films = { ppf: ['/garage-assets/ppf-appliacatio-video-mp4.mp4', 'Rodim PPF · Precision application', 'Film application, edge control and a protected surface built for the cars that matter.'], ceramic: ['/garage-assets/ceramic-coating-video-mp4.mp4', 'Ceramic coating · Depth in the light', 'A controlled coating process for slickness, depth and a finish that keeps its composure.'], wash: ['/garage-assets/car-foam-wash-video-mp4.mp4', 'Foam wash · Reset the whole car', 'Foam, agitation, rinse and a final owner-level check across the exterior and interior.'] }; const modal = document.querySelector('[data-garage-modal]'); const modalVideo = modal?.querySelector('[data-modal-video]'); const modalTitle = modal?.querySelector('[data-modal-title]'); const modalCaption = modal?.querySelector('[data-modal-caption]'); let activeScene = null; let timer = 0; let lastFocused = null;
  const finishIntro = scene => { if (scene.dataset.scene === 'intro') return; scene.classList.add('show-static'); scene.querySelector('.garage-scene-video')?.pause(); };
  const activate = scene => { if (!scene || activeScene === scene) return; activeScene = scene; window.clearTimeout(timer); scenes.forEach(item => { item.classList.toggle('is-current', item === scene); if (item !== scene) { item.classList.remove('show-static'); const otherVideo = item.querySelector('.garage-scene-video'); if (otherVideo) { otherVideo.pause(); otherVideo.currentTime = 0; } } }); const video = scene.querySelector('.garage-scene-video'); if (video) { video.currentTime = 0; video.play().catch(() => {}); timer = window.setTimeout(() => finishIntro(scene), Number(scene.dataset.duration || 6500)); video.addEventListener('ended', () => finishIntro(scene), { once: true }); } };
  const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting && entry.intersectionRatio > .55) activate(entry.target); }), { threshold: [.55, .8] }); scenes.forEach(scene => observer.observe(scene)); activate(scenes[0]);
  const openModal = key => { const film = films[key] || ['/garage-assets/car-interior-detailing-process-20260910162758-mp4.mp4', 'Interior cleaning · The final detail', 'The last pass happens inside: quiet, deliberate and ready for the handover.']; if (!modal) return; lastFocused = document.activeElement; modalTitle.textContent = film[1]; modalCaption.textContent = film[2]; modalVideo.src = film[0]; modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); document.body.classList.add('garage-modal-open'); modalVideo.play().catch(() => {}); modal.querySelector('.garage-modal-close')?.focus(); }; const closeModal = () => { if (!modal) return; modalVideo.pause(); modalVideo.removeAttribute('src'); modalVideo.load(); modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); document.body.classList.remove('garage-modal-open'); lastFocused?.focus?.(); }; document.querySelectorAll('[data-open-service]').forEach(button => button.addEventListener('click', () => openModal(button.dataset.openService))); document.querySelectorAll('[data-close-modal]').forEach(button => button.addEventListener('click', closeModal)); document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal?.classList.contains('is-open')) closeModal(); });
</script>

<style>
  :global(body){background:#000}.garage-experience{background:#000;color:#fff}.garage-scene{position:relative;isolation:isolate;min-height:100svh;height:100svh;overflow:hidden;background:#000;scroll-margin-top:0}.garage-scene::after{content:'';position:absolute;z-index:5;inset:0;background:#000;opacity:1;pointer-events:none;transition:opacity .8s ease}.garage-scene.is-current::after{opacity:0}.garage-scene-video,.garage-static-image{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.garage-scene-video{z-index:-2;opacity:1;transition:opacity 1.2s ease}.garage-scene.show-static .garage-scene-video{opacity:0}.garage-static-image{opacity:1}.garage-black-fade{position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.9),rgba(0,0,0,.2) 62%,rgba(0,0,0,.58)),linear-gradient(0deg,rgba(0,0,0,.82),transparent 52%,rgba(0,0,0,.3));pointer-events:none}.garage-intro .garage-scene-video{z-index:-2}.garage-intro-copy{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;text-shadow:0 3px 26px #000}.garage-intro-copy p{margin:0;color:#fff;font-size:clamp(30px,5vw,70px);font-weight:500;letter-spacing:-.06em}.garage-intro-copy span{display:block;margin-top:14px;color:#ffd09d;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.garage-scroll-indicator{position:absolute;z-index:3;bottom:34px;left:50%;display:grid;gap:10px;transform:translateX(-50%);color:#fff;font-size:10px;letter-spacing:.15em;text-align:center;text-transform:uppercase;text-shadow:0 2px 14px #000}.garage-scroll-indicator b{font-size:23px;color:#ffd09d;font-weight:400}.garage-wall-copy{position:absolute;z-index:3;left:max(24px,7vw);bottom:12vh;width:min(520px,calc(100% - 48px));padding:24px 28px;border-left:1px solid #ffd09d;background:linear-gradient(90deg,rgba(0,0,0,.72),rgba(0,0,0,.12));backdrop-filter:blur(9px);text-shadow:0 2px 18px #000;opacity:0;transform:translateY(25px);transition:opacity .55s ease .2s,transform .65s cubic-bezier(.23,1,.32,1)}.garage-scene.show-static .garage-wall-copy{opacity:1;transform:none}.garage-kicker{margin:0;color:#ffd09d;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.garage-wall-copy h1{margin:14px 0 20px;color:#fff;font-size:clamp(54px,7vw,106px);font-weight:500;letter-spacing:-.06em;line-height:.9}.garage-wall-copy h1 em{color:#ffd09d;font-style:normal}.garage-wall-copy>p:not(.garage-kicker){max-width:430px;margin:0;color:#fff;font-size:17px;line-height:1.6}.garage-button{display:inline-flex;align-items:center;gap:20px;margin-top:22px;padding:15px 18px;border:1px solid #ffd09d;color:#0a0a0a;background:#ffd09d;font:inherit;font-size:11px;font-weight:800;letter-spacing:.1em;text-decoration:none;text-transform:uppercase;cursor:pointer;transition:transform .2s ease,background .2s ease}.garage-button:hover{transform:translateY(-3px);background:#fff1d8}.garage-button b{font-size:18px;font-weight:400}.garage-scene-state{position:absolute;z-index:4;right:34px;bottom:38px;color:#ffd09d;font-size:13px;letter-spacing:.14em}.garage-scene-state span{color:#fff}.garage-modal{position:fixed;z-index:200;inset:0;display:grid;place-items:center;padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease,visibility .25s ease}.garage-modal.is-open{opacity:1;visibility:visible;pointer-events:auto}.garage-modal-backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.9)}.garage-modal-dialog{position:relative;z-index:1;width:min(900px,100%);border:1px solid rgba(255,208,157,.6);background:#070707}.garage-modal-top{display:flex;justify-content:space-between;align-items:center;padding:15px 18px;color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.garage-modal-close{width:34px;height:34px;border:1px solid rgba(255,255,255,.35);border-radius:50%;color:#fff;background:transparent;font-size:24px;cursor:pointer}.garage-modal-video{aspect-ratio:16/9;background:#000}.garage-modal-video video{width:100%;height:100%;object-fit:contain}.garage-modal-caption{padding:17px 18px 20px;color:#eaf1f5;font-size:13px;line-height:1.55}.garage-modal-open{overflow:hidden}
  @media(max-width:760px){.garage-scene{min-height:calc(100svh - 72px);height:calc(100svh - 72px)}.garage-intro-copy p{font-size:clamp(30px,10vw,54px);white-space:nowrap}.garage-wall-copy{left:20px;bottom:94px;width:calc(100% - 40px);padding:19px 18px}.garage-wall-copy h1{font-size:clamp(48px,14vw,78px)}.garage-wall-copy>p:not(.garage-kicker){font-size:15px}.garage-scene-state{right:20px;bottom:28px}.garage-scene-video,.garage-static-image{object-position:center}}
  @media(prefers-reduced-motion:reduce){.garage-scene::after,.garage-scene-video,.garage-wall-copy,.garage-modal,.garage-button{transition:none}}
</style>
