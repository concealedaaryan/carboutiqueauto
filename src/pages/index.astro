---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { ppfOptions } from '../data/catalog';

const heroSlides = [
  { src: '/images/drive/black-luxury-sedan.jpeg', eyebrow: 'Crest Automotive Care · Rodim PPF studio', caption: 'Protection for the cars that matter', description: 'A graphite luxury sedan prepared for Rodim paint protection film inside Crest Automotive Care.' },
  { src: '/images/drive/applying-ppf.jpeg', eyebrow: 'Rodim PPF · Precision installation', caption: 'Clean alignment · controlled finish', description: 'A precision Rodim PPF installation detail showing careful film alignment on a dark vehicle.' },
  { src: '/images/drive/black-sports-car.jpeg', eyebrow: 'Inside DLF The Camellias', caption: 'Private in-house care in Gurgaon', description: 'A premium private automotive studio prepared for Crest detailing and Rodim PPF care.' },
];

const ppfVariants = ppfOptions.filter((film) => film.officialProduct).map((film) => ({ name: film.name, description: film.positioning, officialUrl: film.officialUrl }));

const faqItems = [
  { question: 'Is PPF worth it for a luxury or premium car?', answer: 'PPF is most useful when preserving the original paint matters: it can help defend selected painted surfaces from stone chips, light scratches, road grime and everyday wear. The right value depends on the vehicle, driving pattern, coverage plan and installation quality.' },
  { question: 'What is Rodim PPF?', answer: 'Rodim is Crest Automotive Care’s paint protection film range. The film is selected by variant, finish and coverage for the vehicle’s use.' },
  { question: 'What is the material technology context?', answer: 'The right protection system depends on the film variant, coverage, finish, preparation and aftercare. Crest will explain the selected option and care requirements before installation.' },
  { question: 'Does PPF turn yellow?', answer: 'Yellowing risk depends on the film construction, exposure, maintenance, installation and time. Crest will help you compare the appropriate Rodim variant and confirm the current product documentation and warranty terms before installation.' },
  { question: 'Does PPF self-heal?', answer: 'Some Rodim variants are positioned as self-healing options. Self-healing generally refers to the film’s ability to reduce the appearance of certain light surface marks with suitable heat and care; it does not mean deep cuts or major damage disappear.' },
  { question: 'PPF or ceramic coating: which should I choose?', answer: 'PPF is a physical sacrificial layer for impact-prone painted areas. Ceramic coating is a surface treatment that can make paint, glass, trim or PPF easier to maintain and more hydrophobic. Many owners use PPF on priority panels and coating as part of the wider maintenance system.' },
  { question: 'Can PPF be removed?', answer: 'Professionally installed PPF can generally be removed when replacement or paint work is needed, but the result depends on film age, adhesive condition, paint condition and the removal method. Crest should inspect the vehicle before confirming a removal plan.' },
  { question: 'How long does PPF installation take?', answer: 'Installation time depends on the vehicle, preparation, coverage, film variant, panel complexity and agreed finish. Crest confirms the practical handover window after inspecting the car rather than promising one fixed duration for every vehicle.' },
  { question: 'Should I protect the full body or only selected panels?', answer: 'Full-body coverage offers the broadest protection, while partial coverage can focus investment on areas such as the bumper, bonnet, fenders, mirrors, door edges and loading zones. The best plan depends on how and where the car is driven.' },
  { question: 'Can PPF be gloss or matte?', answer: 'Yes. Gloss and matte or satin finishes create different visual outcomes. Rodim R2 Matt Finish is the matte-oriented option in the supplied range; Crest should confirm compatibility with the vehicle’s existing paint and the exact finish before booking.' },
  { question: 'How do I maintain PPF after installation?', answer: 'Use clean, paint-safe washing methods, avoid harsh chemicals and abrasive tools, and follow the care instructions supplied with the film. Crest can also advise on suitable coating and aftercare options for the film and the rest of the vehicle.' },
  { question: 'What affects the cost of PPF?', answer: 'The main factors are vehicle size and shape, film variant, coverage area, finish, paint correction or preparation required, removal of existing film, and any additional coating or aftercare. Crest confirms the final scope after reviewing the car.' },
];
---
<SiteLayout title="Rodim PPF and Premium Car Care in DLF Gurugram" description="Crest Automotive Care installs Rodim paint protection film and provides premium car care in DLF Gurugram, serving DLF The Camellias, DLF Crest and DLF The Magnolias." currentPath="/">
  <section id="station-01" class="hero-shell station-arrival" data-section="hero" data-station="01" data-station-name="Arrival / front desk">
    <div class="hero-copy reveal">
      <span class="eyebrow studio-kicker"><span class="typing-text" data-typing-text="Crest Automotive Care · Rodim PPF" aria-hidden="true"></span><span class="sr-only">Crest Automotive Care · Rodim PPF</span></span>
      <h1>Protect the paint<br /><em>Keep the presence</em></h1>
      <p>Rodim paint protection film, installed with precision across Crest Automotive Care studios in DLF Crest, DLF The Magnolias and DLF The Camellias, Gurgaon. Built for owners who expect more from the finish on a luxury, premium or enthusiast vehicle.</p>
      <div class="hero-actions"><a class="button button-gold" href="/contact">Discuss your car <span>↗</span></a><a class="text-action" href="/rodim">Explore the Rodim range <span>→</span></a></div>
      <div class="hero-trust"><strong>Studios across DLF Crest · The Magnolias · The Camellias</strong><span>In-house care for all three DLF communities · Gurgaon</span></div>
    </div>
    <div class="hero-media reveal reveal-delay-1"><HeroCarousel slides={heroSlides} label="Crest Automotive Care and Rodim PPF studio images" /></div>
  </section>

  <section class="proof-bar"><div><strong>Rodim PPF</strong><span>Primary protection system</span></div><div><strong>Two-stage check</strong><span>Technician, then owner-level inspection</span></div><div><strong>Luxury focus</strong><span>From Rolls-Royce to Tesla categories</span></div><div><strong>Aftercare</strong><span>Ongoing post-service support</span></div></section>

  <section id="station-02" class="trust-section station-intake" data-station="02" data-station-name="Vehicle intake bay">
    <div class="section-intro reveal"><span class="eyebrow">Trust by address</span><h2>When the most exacting<br /><em>neighbours trust you</em></h2></div>
    <div class="trust-copy reveal reveal-delay-1"><p>Our studios are present within DLF The Camellias, DLF Crest and DLF The Magnolias in DLF Phase 5, Gurgaon. That proximity matters: residents of three of Gurgaon’s most exclusive addresses can access Crest care close to home, with the same considered approach to every vehicle.</p><small>Crest Automotive Care is located within the community and is not an official DLF partner, service or endorsement.</small></div>
  </section>

  <section id="what-is-ppf" class="education-section station-prep" data-station-anchor="03" data-station="03" data-station-name="Preparation bay">
    <div class="education-image reveal"><img src="/images/drive/water-droplets.jpeg" alt="Water droplets beading on a protected car surface" loading="lazy" /></div>
    <div class="education-copy reveal reveal-delay-1"><span class="eyebrow">What is Rodim PPF?</span><h2>A physical layer<br /><em>between paint and road</em></h2><p>Paint protection film is a clear or finish-changing film applied over painted panels. It is designed to take the first contact from stone chips, light scratches, road debris and environmental wear so the original paint can stay cleaner and easier to preserve.</p><div class="fact-grid"><div><strong>Impact first</strong><span>Helps protect priority painted surfaces.</span></div><div><strong>Finish choice</strong><span>Compare gloss, matte and darker visual options.</span></div><div><strong>System thinking</strong><span>Pair film with preparation, coating and aftercare.</span></div></div></div>
  </section>

  <section id="rodim-range" class="range-section station-lab" data-station-anchor="04" data-station="04" data-station-name="Protection lab">
    <div class="section-intro reveal"><span class="eyebrow">The Rodim range</span><h2>Five ways to choose<br /><em>your shield</em></h2><p>Every vehicle, finish and driving pattern is different. Crest will confirm the right variant, coverage and current commercial terms after reviewing the car.</p></div>
    <div class="variant-grid">{ppfVariants.map((variant, index) => <article class="variant-card reveal"><span class="variant-number">0{index + 1}</span><h3>{variant.name}</h3><p>{variant.description}</p><a href={variant.officialUrl} target="_blank" rel="noopener noreferrer">View {variant.name} on Rodim.in <span>↗</span></a></article>)}</div>
  </section>

  <section id="station-05" class="basf-section station-correction" data-station="05" data-station-name="Correction bay">
    <div class="basf-copy reveal"><span class="eyebrow">Material technology context</span><h2>Why the right film<br /><em>needs the right process</em></h2><p>The right protection system depends on the film variant, coverage, finish, preparation and aftercare. Crest will explain the selected option and care requirements before installation.</p></div>
  </section>

  <section id="station-06" class="cars-section station-handover" data-station="06" data-station-name="Handover inspection">
    <div class="cars-copy reveal"><span class="eyebrow">Cars we have protected</span><h2>Serious cars deserve<br /><em>serious preparation</em></h2><p>Crest specializes in premium and luxury vehicles across Delhi NCR, including cars in the Rolls-Royce, Bentley, Lamborghini, Range Rover, Porsche, Tesla, BMW and Mercedes-AMG categories. These are service-history examples, not brand partnerships or endorsements.</p><a class="text-action" href="/contact">Talk through your vehicle <span>→</span></a></div>
    <div class="cars-list reveal reveal-delay-1"><span>Rolls-Royce</span><span>Bentley</span><span>Lamborghini</span><span>Range Rover</span><span>Porsche</span><span>Tesla</span><span>BMW</span><span>Mercedes-AMG</span></div>
  </section>

  <section id="station-07" class="process-section station-standard" data-station="07" data-station-name="Crest standard">
    <div class="section-intro reveal"><span class="eyebrow">The Crest standard</span><h2>Protection is only as good<br /><em>as the handover</em></h2><p>Our process is built to make the final result accountable, not just attractive at first glance.</p></div>
    <div class="process-grid"><article class="process-card reveal"><span>01</span><h3>Technician inspection</h3><p>The installation team checks alignment, edges, surface preparation and finish during the work.</p></article><article class="process-card reveal reveal-delay-1"><span>02</span><h3>Owner-level final check</h3><p>Ranjeev Kapoor or Ruchir Malhotra completes a final review before the vehicle is handed back.</p></article><article class="process-card reveal reveal-delay-2"><span>03</span><h3>Ongoing support</h3><p>Crest remains available after delivery for care guidance, questions and the next protection decision.</p></article></div>
  </section>

  <section id="ppf-faq" class="faq-section station-desk" data-station-anchor="08" data-station="08" data-station-name="Service desk">
    <div class="section-intro reveal"><span class="eyebrow">PPF questions, answered</span><h2>Make the right decision<br /><em>with clearer facts</em></h2></div>
    <div class="faq-list">{faqItems.map((item) => <details class="faq-item reveal"><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>

  <section class="other-services"><div><span class="eyebrow">Also available</span><h2>Complete the system<br /><em>around the film</em></h2></div><p>Crest also offers ceramic coating, nano ceramic coating and rubber-sheet protection. These are supporting options; the right combination depends on your paint, usage and the Rodim coverage you choose.</p><a class="text-action" href="/protection">See supporting protection options <span>→</span></a></section>

  <section id="station-09" class="home-cta station-concierge" data-station="09" data-station-name="Concierge desk"><div class="cta-copy reveal"><span class="eyebrow">Start with your car</span><h2>Protect what makes<br /><em>it yours</em></h2><p>Share the vehicle, current finish and the areas you want to protect. Crest will help you compare the Rodim range and confirm the next step.</p><a class="button button-gold" href="/contact">Request a Rodim consultation <span>↗</span></a></div><div class="cta-contact reveal reveal-delay-1"><span>Talk directly</span><a href="tel:+919871610952">+91 98716 10952</a><span>WhatsApp concierge</span><a href="https://wa.me/919871610952" target="_blank" rel="noopener noreferrer">Message the team ↗</a></div></section>

</SiteLayout>
<style>
  .hero-shell,.trust-section,.education-section,.range-section,.basf-section,.cars-section,.process-section,.faq-section,.other-services,.home-cta{max-width:var(--max);margin:0 auto;padding:110px 24px}.hero-shell{display:grid;grid-template-columns:.88fr 1.12fr;gap:70px;align-items:center;min-height:720px;padding-top:145px}.hero-shell::before{content:'';position:absolute;z-index:-1;inset:84px 0 auto;height:650px;background:radial-gradient(circle at 78% 34%,rgba(59,130,246,.12),transparent 30%),linear-gradient(115deg,#131315 30%,#0b2038 100%)}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--gold);font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.hero-copy h1,h2,h3, .hero-copy h1 em, h2 em, h3 em{font-family:'Inter',sans-serif;color:var(--white);font-weight:600;line-height:1.08;letter-spacing:-.04em;font-style:normal}.hero-copy h1{margin:20px 0 23px;font-size:clamp(40px,4.6vw,62px)!important}h2{margin:15px 0 20px;font-size:clamp(34px,4vw,52px)}h3{margin:0;font-size:22px}em{color:var(--gold-soft);font-style:normal}.hero-copy>p,.education-copy>p,.cars-copy>p,.section-intro>p,.basf-copy>p,.other-services>p,.cta-copy>p{color:var(--muted);font-size:16px;line-height:1.7}.hero-copy>p{max-width:560px;color:var(--white);font-size:clamp(17px,1.35vw,19px)!important;line-height:1.6!important}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:34px}.text-action{display:inline-flex;align-items:center;gap:10px;color:var(--gold-soft);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.text-action:hover{color:var(--white)}.hero-media{position:relative;min-height:520px;overflow:hidden;border:1px solid rgba(59,130,246,.32);background:var(--panel)}.hero-media img{height:520px}.hero-trust{display:grid;gap:4px;margin-top:36px;padding-left:17px;border-left:1px solid var(--gold)}.hero-trust strong{color:var(--white);font-size:12px}.hero-trust span{color:var(--muted);font-size:11px}.proof-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--line)}.proof-bar>div{display:grid;gap:8px;padding:27px 24px;background:#0d2440}.proof-bar strong{color:var(--white);font-size:14px}.proof-bar span{color:var(--muted);font-size:10px;line-height:1.4}.trust-section{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end}.trust-copy{padding:27px 0 0 30px;border-left:1px solid var(--gold)}.trust-copy p{margin:0;color:var(--white);font-size:16px;line-height:1.7}.trust-copy small,.note{color:#526e83!important;font-size:13px!important;line-height:1.6!important}.education-section{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center;background:#1b1b1d;max-width:none;padding-inline:max(24px,calc((100% - var(--max)) / 2))}.education-image{min-height:500px}.education-image img{display:block;width:100%;height:500px;object-fit:cover}.education-copy{max-width:560px}.education-copy>p{max-width:510px}.fact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:34px;padding-top:22px;border-top:1px solid var(--line)}.fact-grid div{display:grid;gap:8px}.fact-grid strong{color:var(--white);font-size:11px;text-transform:uppercase;letter-spacing:.06em}.fact-grid span{color:var(--muted);font-size:11px;line-height:1.5}.range-section{max-width:none;background:#0b2038;padding-inline:max(24px,calc((100% - var(--max)) / 2))}.section-intro{max-width:720px;margin-bottom:46px}.section-intro>p{max-width:560px;margin-top:0}.variant-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:var(--max);margin:0 auto}.variant-card{display:flex;min-height:255px;flex-direction:column;padding:24px;border:1px solid var(--line);background:rgba(13,36,64,.8);transition:transform .25s var(--ease),border-color .25s ease}.variant-card:hover{transform:translateY(-6px);border-color:var(--gold)}.variant-number{color:var(--gold);font-size:10px;font-weight:700;letter-spacing:.12em}.variant-card h3{margin-top:40px;font-size:22px}.variant-card p{margin:10px 0;color:var(--muted);font-size:13px;line-height:1.6}.variant-card a{margin-top:auto;padding-top:15px;border-top:1px solid var(--line);color:var(--gold-soft);font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.basf-section{display:block}.basf-copy{max-width:760px;margin:0 auto}.basf-copy>p{max-width:720px}.cars-section{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center;background:#f4eadb;color:#123d66;max-width:none;padding-inline:max(24px,calc((100% - var(--max)) / 2))}.cars-section .eyebrow{color:#a35f32}.cars-copy{max-width:570px}.cars-copy h2{color:#123d66}.cars-copy h2 em{color:#a35f32}.cars-copy>p{color:#31465a!important}.cars-copy .text-action{color:#123d66}.cars-copy .text-action:hover{color:#a35f32}.cars-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(18,61,102,.22)}.cars-list span{padding:20px 0;border-bottom:1px solid rgba(18,61,102,.22);color:#123d66;font-size:15px;font-weight:600}.cars-list span:nth-child(odd){margin-right:24px}.process-section{max-width:none;padding-inline:max(24px,calc((100% - var(--max)) / 2))}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:var(--max);margin:0 auto}.process-card{min-height:230px;padding:25px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(59,130,246,.1),rgba(255,255,255,.02))}.process-card>span{color:var(--gold);font-size:11px;font-weight:700}.process-card h3{margin-top:48px;font-size:22px}.process-card p{color:var(--muted);font-size:14px;line-height:1.6}.faq-section{max-width:none;background:#0b2038;padding-inline:max(24px,calc((100% - var(--max)) / 2))}.faq-list{max-width:var(--max);margin:0 auto}.faq-item{border-top:1px solid var(--line)}.faq-item:last-child{border-bottom:1px solid var(--line)}.faq-item summary{display:flex;justify-content:space-between;gap:20px;padding:21px 0;color:var(--white);font-size:1