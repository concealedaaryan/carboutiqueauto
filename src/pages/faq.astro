---
import SiteLayout from '../layouts/SiteLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { faqs } from '../data/catalog';
---
<SiteLayout title="FAQ" description="Frequently asked questions about Crest Automotive treatments, locations, pricing, packages and protection." currentPath="/faq" pageNumber="06" pageLabel="Frequently asked">
  <StructuredData type="faq" faqs={faqs} />
  <section class="faq-hero"><div><span class="eyebrow">Frequently asked</span><h1>Good questions.<br /><em>Clear answers.</em></h1><p>Still have a question about your car, your package or our process? Start here, then call the team directly if you need a vehicle-specific answer.</p><a class="button button-gold" href="/contact">Ask the team <span>↗</span></a></div><div class="faq-visual"><span>Q / A</span><strong>Considered care<br />starts with clarity.</strong><small>CREST AUTOMOTIVE STUDIO</small></div></section>
  <section class="faq-section"><div class="faq-intro"><span class="eyebrow">What customers ask</span><h2>Everything before<br /><em>the first visit.</em></h2></div><div class="faq-list">{faqs.map((faq, index) => <details class="faq-item" open={index === 0}><summary><strong>{faq.question}</strong><b>+</b></summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="faq-cta"><div><span class="eyebrow">Still unsure?</span><h2>Tell us about<br /><em>your car.</em></h2></div><div><p>Share your model, community and preferred treatment. We will help you choose the right tier before booking.</p><a class="button button-gold" href="/contact">Start an enquiry <span>↗</span></a></div></section>
</SiteLayout>
<style>
  .faq-hero, .faq-section, .faq-cta { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .faq-hero { display: grid; grid-template-columns: 1fr .85fr; gap: 90px; align-items: center; min-height: 600px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { color: var(--white); line-height: 1.05; letter-spacing: -.06em; }
  h1 { margin: 18px 0 24px; font-size: clamp(52px,6vw,86px); }
  h2 { margin: 12px 0 0; font-size: clamp(42px,5vw,64px); }
  .faq-hero p { max-width: 490px; margin-bottom: 31px; color: var(--muted); font-size: 16px; }
  .faq-visual { min-height: 410px; display: flex; flex-direction: column; justify-content: end; padding: 28px; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(59,130,246,.18), rgba(19,19,21,.86)); }
  .faq-visual span { color: var(--gold); font-size: 62px; font-weight: 700; letter-spacing: -.08em; }
  .faq-visual strong { margin-top: auto; color: var(--white); font-size: 25px; line-height: 1.12; letter-spacing: -.04em; }
  .faq-visual small { margin-top: 14px; color: #9eacc0; font-size: 9px; letter-spacing: .13em; }
  .faq-section { max-width: none; background: #1b1b1d; }
  .faq-intro, .faq-list { max-width: var(--max); margin-left: auto; margin-right: auto; }
  .faq-intro { margin-bottom: 45px; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { display: grid; grid-template-columns: 1fr 30px; gap: 16px; align-items: center; padding: 23px 0; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary strong { color: var(--white); font-size: 17px; letter-spacing: -.02em; }
  .faq-item summary b { justify-self: end; color: var(--gold); font-size: 22px; font-weight: 400; transition: transform .2s ease; }
  .faq-item[open] summary b { transform: rotate(45deg); }
  .faq-item p { max-width: 760px; margin: -3px 46px 24px 0; color: var(--muted); font-size: 14px; }
  .faq-cta { display: flex; align-items: end; justify-content: space-between; gap: 60px; }
  .faq-cta > div:last-child { max-width: 350px; }
  .faq-cta p { margin: 0 0 25px; color: var(--muted); font-size: 14px; }
  @media (max-width: 850px) { .faq-hero { grid-template-columns: 1fr; gap: 45px; } .faq-cta { display: block; } .faq-cta > div:last-child { margin-top: 25px; } }
  @media (max-width: 620px) { .faq-hero, .faq-section, .faq-cta { padding: 80px 20px; } .faq-hero { min-height: auto; padding-top: 88px; } .faq-visual { min-height: 300px; } .faq-item summary { grid-template-columns: 1fr 24px; gap: 10px; } .faq-item summary strong { font-size: 14px; } .faq-item p { margin-left: 0; margin-right: 23px; font-size: 12px; } }
</style>
