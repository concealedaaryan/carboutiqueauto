---
import SiteLayout from '../layouts/SiteLayout.astro';
import StructuredData from '../components/StructuredData.astro';

const poster = '/garage-assets/service-wall-water-wash-etc-jpeg.jpeg';
const washVideo = '/garage-assets/car-wash-services-wall-mp4.mp4';
const coatingVideo = '/garage-assets/ceramic-coating-video-mp4.mp4';
const sections = [
  { id:'daily-exterior-care', eyebrow:'01 / Exterior ritual', title:'Daily Exterior Care', detail:'Clean, protect and restore the finish you live with every day.', motion:'from-bottom', video:washVideo, services:[['Premium Waterless Wash & Wax','Save water · no swirl marks','₹200–₹500'],['Car Exterior High-Pressure Wash','Exterior only','₹200–₹600'],['Exterior Wash + Wax Polish','Hand-applied finish','₹800–₹2,000']] },
  { id:'interior-cabin-care', eyebrow:'02 / Cabin reset', title:'Interior & Cabin Care', detail:'A calmer, deeper reset for the spaces you spend time in.', motion:'from-left', video:washVideo, services:[['Interior Cleaning (Basic)','Daily-ready cabin','₹250–₹600'],['Premium Interior Enrichment','Full deep clean','₹1,500–₹4,500'],['Leather Seat Polishing & Conditioning','Add-on service','₹500–₹1,500']] },
  { id:'combos', eyebrow:'03 / Considered combinations', title:'Combos', detail:'Pair the rituals that make the biggest difference to your drive.', motion:'from-right', video:washVideo, services:[['Waterless Wash + Interior Cleaning','Combo 1','₹300–₹600'],['Triple Wash + Interior Cleaning','Combo 2','₹350–₹750'],['Premium Interior & Exterior Enrichment','Combo 3','₹2,500–₹9,000']] },
  { id:'paint-correction-coating', eyebrow:'04 / Surface protection', title:'Paint Correction & Coating', detail:'Restore clarity, then protect it for the road ahead.', motion:'from-top', video:coatingVideo, services:[['Exterior Polishing & Paint Correction','Machine finish','₹2,000–₹5,500'],['Nano Ceramic Coating','1 year protection','₹10,000–₹20,000'],['Premium Ceramic Coating','3 year warranty · 2–3 days','₹15,000–₹35,000'],['Premium Graphene Coating','3 year warranty · 2–3 days','₹22,000–₹42,000']] },
  { id:'glass-cabin-comfort', eyebrow:'05 / Finishing touches', title:'Glass & Cabin Comfort', detail:'Small details that make every journey feel better.', motion:'rotate-in', video:coatingVideo, services:[['Sun Film Application','Govt-approved levels','₹1,500–₹55,000'],['Rain Screen & Windscreen Treatment','Visibility care','₹700–₹2,000'],['Sound Deadening Pads Installation','All doors','₹28,000–₹38,000']] },
];
const structuredServices = sections.flatMap((section) => section.services.map(([name, description, price]) => ({ name, description: `${description}. ${price}`, url: `/services#${section.id}` })));
---
<SiteLayout title="Premium Car Detailing Services in DLF Gurugram" description="Explore premium car detailing, waterless wash, paint correction, ceramic coating and protection services from Crest Automotive Care in DLF Gurugram." currentPath="/services" pageLabel="The treatment menu">
  <StructuredData type="services" services={structuredServices} />
  <div class="services-page">
    <div class="services-video-layer" aria-hidden="true"><video id="services-background-video" autoplay muted loop playsinline poster={poster} src={washVideo}></video><div class="services-video-scrim"></div></div>
    <section class="services-intro"><span class="eyebrow">The treatment menu</span><h1>Detailing that respects<br /><em>the machine.</em></h1><p>From a daily waterless refresh to multi-year surface protection, choose the ritual that fits the drive.</p><a class="button button-gold" href="/estimate">Build your estimate <span>↗</span></a></section>
    <div class="services-flow">{sections.map((section) => <section class={`service-chapter ${section.motion}`} id={section.id} data-video={section.video}><div class="chapter-heading"><span class="eyebrow">{section.eyebrow}</span><h2>{section.title}</h2><p>{section.detail}</p></div><div class="service-cards">{section.services.map(([title, tagline, price], index) => <article class="service-card" data-service-card style={`--delay:${index * 150}ms`}><div><span class="card-tag">{tagline}</span><h3>{title}</h3></div><div class="card-bottom"><strong>{price}</strong><a href="/estimate">Book Now <span>→</span></a></div></article>)}</div><p class="section-note">*GST 18% extra. Final price confirmed after vehicle inspection.</p></section>)}</div>
  </div>
</SiteLayout>

<style is:global>
  body:has(.services-page){background:#050608!important} body:has(.services-page) main{background:transparent!important} body:has(.services-page) .site-footer{position:relative;z-index:3;background:#050608!important}
  .services-page{position:relative;isolation:isolate;min-height:100vh;overflow:clip;color:#fff}.services-video-layer{position:fixed;z-index:-1;inset:0;pointer-events:none;background:#050608}.services-video-layer video{display:block;width:100%;height:100%;object-fit:cover;object-position:center;opacity:.72;transition:opacity .5s ease}.services-video-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,5,8,.58),rgba(3,5,8,.38) 35%,rgba(3,5,8,.68))}
  .services-intro,.services-flow{position:relative;z-index:1;max-width:1120px;margin-inline:auto;padding-inline:24px}.services-intro{min-height:86vh;display:flex;flex-direction:column;justify-content:center;padding-top:120px}.services-intro h1{max-width:800px;margin:16px 0 22px;color:#fff;font-size:clamp(48px,8vw,104px);line-height:.98;letter-spacing:-.07em}.services-intro h1 em{color:#c9d7e8;font-style:normal}.services-intro p{max-width:480px;margin:0 0 30px;color:rgba(255,255,255,.78)!important;font-size:16px}.services-flow{padding-bottom:100px}.service-chapter{min-height:100vh;padding:120px 0 100px;scroll-margin-top:80px}.chapter-heading{max-width:670px;margin-bottom:38px}.chapter-heading h2{margin:12px 0 14px;color:#fff;font-size:clamp(38px,6vw,72px);line-height:1;letter-spacing:-.06em}.chapter-heading p{max-width:520px;color:rgba(255,255,255,.76)!important;font-size:16px}.service-cards{display:grid;gap:18px;max-width:820px}.service-card{min-height:190px;display:flex;flex-direction:column;justify-content:space-between;padding:27px;border:1px solid rgba(255,255,255,.19);border-radius:16px;background:rgba(255,255,255,.095)!important;backdrop-filter:blur(14px) saturate(135%);-webkit-backdrop-filter:blur(14px) saturate(135%);box-shadow:inset 1px 1px rgba(255,255,255,.14),0 18px 60px rgba(0,0,0,.14);opacity:0;transform:translate3d(0,80px,0);transition:opacity .7s cubic-bezier(.22,1,.36,1) var(--delay),transform .7s cubic-bezier(.22,1,.36,1) var(--delay),border-color .25s ease,background .25s ease}.from-left .service-card{transform:translate3d(-100px,0,0)}.from-right .service-card{transform:translate3d(100px,0,0)}.from-top .service-card{transform:translate3d(0,-80px,0)}.rotate-in .service-card{transform:rotate(-8deg) scale(.85)}.service-card.is-visible{opacity:1;transform:translate3d(0,0,0) rotate(0) scale(1)!important}.service-card:hover,.service-card:focus-within{border-color:rgba(255,255,255,.48);background:rgba(255,255,255,.15)!important}.card-tag,.eyebrow{color:#b8d4ff;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.service-card h3{max-width:620px;margin:12px 0 8px;color:#fff;font-size:clamp(22px,3vw,31px);line-height:1.08;letter-spacing:-.04em}.card-bottom{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-top:30px}.card-bottom strong{color:#fff;font-size:18px}.card-bottom a{color:#d7e7ff!important;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.card-bottom a span{display:inline-block;margin-left:7px;transition:transform .2s ease}.card-bottom a:hover span{transform:translateX(4px)}.section-note{margin:22px 0 0;color:rgba(255,255,255,.62)!important;font-size:11px;font-style:italic}
  @media(max-width:768px){.services-video-layer video{object-fit:contain;background:#050608;opacity:.8}.services-video-scrim{background:linear-gradient(180deg,rgba(3,5,8,.52),rgba(3,5,8,.32) 40%,rgba(3,5,8,.7))}.services-intro,.services-flow{padding-inline:20px}.services-intro{min-height:78svh;padding-top:110px}.services-intro h1{font-size:clamp(46px,14vw,76px)}.service-chapter{min-height:100svh;padding:100px 0 90px}.service-card{min-height:180px;padding:22px;backdrop-filter:blur(6px) saturate(130%);-webkit-backdrop-filter:blur(6px) saturate(130%)}.from-left .service-card,.from-right .service-card,.from-top .service-card,.rotate-in .service-card{transform:translate3d(0,80px,0)}}
  @media(prefers-reduced-motion:reduce){.service-card,.service-card.is-visible{opacity:1;transform:none!important;transition:none}}
</style>
<script is:inline data-astro-rerun>
  (()=>{const root=document.querySelector('.services-page');if(!root)return;const video=root.querySelector('#services-background-video');video.muted=true;video.defaultMuted=true;video.loop=true;video.setAttribute('muted','');video.setAttribute('playsinline','');const cards=[...root.querySelectorAll('[data-service-card]')];const chapters=[...root.querySelectorAll('.service-chapter')];const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;const setVideo=(src)=>{if(!video||video.getAttribute('src')===src)return;video.style.opacity='.25';video.src=src;video.load();video.play().catch(()=>{});setTimeout(()=>video.style.opacity='',180)};if(reduced||!('IntersectionObserver'in window))cards.forEach(c=>c.classList.add('is-visible'));else{const observer=new IntersectionObserver(entries=>entries.forEach(e=>e.isIntersecting?e.target.classList.add('is-visible'):e.target.classList.remove('is-visible')),{threshold:.2});cards.forEach(c=>observer.observe(c))}if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)setVideo(e.target.dataset.video)}),{threshold:.35});chapters.forEach(c=>observer.observe(c))}})();
</script>
<script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ItemList',itemListElement:structuredServices.map((service,index)=>({'@type':'ListItem',position:index+1,name:service.name}))})}></script>
