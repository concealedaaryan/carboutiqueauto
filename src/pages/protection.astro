---
import SiteLayout from '../layouts/SiteLayout.astro';
import { coatingPackages, ppfOptions, protectionAddOns } from '../data/catalog';
---
<SiteLayout title="Rodim PPF and Ceramic Coatings in DLF Gurugram" description="Compare Rodim PPF, ceramic coating, graphene and surface-protection options from Crest Automotive Care in DLF Gurugram." currentPath="/protection" pageNumber="03" pageLabel="Surface protection">
  <video class="protection-pinned-video" data-protection-pinned-video autoplay muted loop playsinline preload="auto" aria-hidden="true"><source src="/rodim-assets/rodimppf.mp4" type="video/mp4" /></video>
  <section class="protection-hero"><div><span class="eyebrow">Crest Automotive Care · Rodim PPF</span><h1>More gloss.<br /><em>More protection.</em></h1><p>Crest helps you compare Rodim paint protection films and plan an installation around your vehicle, paint condition and intended coverage.</p><a class="button button-gold" href="/estimate">Build a Rodim PPF estimate <span>↗</span></a></div></section>
  <section class="protection-story"><div class="protection-story-copy"><span class="eyebrow">The Rodim approach</span><h2>Film first.<br /><em>Finish second.</em></h2><p>Rodim PPF works best as a considered system: prepare the surface, install the right film, then maintain the finish with coatings and careful aftercare.</p><div class="protection-beats"><div><strong>Prepare</strong><span>Paint condition and coverage come first.</span></div><div><strong>Protect</strong><span>Rodim PPF takes the road impact.</span></div><div><strong>Maintain</strong><span>Coatings keep the finish easier to live with.</span></div></div></div></section>
  <section class="coating-section" id="ceramic"><div class="intro"><span class="eyebrow">Ceramic & graphene</span><h2>Surface confidence,<br /><em>layer by layer.</em></h2><p>Choose from nano ceramic, premium ceramic or premium graphene treatments. The exact process depends on paint condition, prior repairs, model and agreed scope.</p></div><div class="coating-grid">{coatingPackages.map((pkg, index) => <article class={`coating-card ${index === 2 ? 'featured' : ''}`}><h3>{pkg.name}</h3><p>{index === 0 ? 'Entry protection for a cleaner, glossier daily finish.' : index === 1 ? 'Correction-led premium ceramic with glass, trim and interior care.' : 'Graphene protection with correction, glass and alloy protection.'}</p><strong>{pkg.prices[0]}<small>from</small></strong><em>{pkg.warranty}</em><a href={`/estimate?service=${index === 0 ? '11' : index === 1 ? '12' : '13'}`}>Estimate this coating <span>↗</span></a></article>)}</div></section>
  <section class="ppf-section"><div class="ppf-heading"><div><span class="eyebrow">Rodim paint protection film</span><h2>Choose your Rodim shield.</h2></div><p>Rodim thermoplastic paint protection film, described by Crest as manufactured using BASF technology, helps defend against scratches, swirl marks, road debris and environmental wear. Compare the available Rodim film variants with the Crest team, then confirm the right film and coverage for your vehicle. Verify the BASF relationship against current supplier documentation before publication.</p></div><div class="ppf-list" aria-label="Rodim paint protection film variants">{ppfOptions.filter((film) => film.officialProduct).map((film, index) => <article class="ppf-list-item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{film.name}</strong><div><a href={film.officialUrl} target="_blank" rel="noopener noreferrer">View {film.name} on Rodim.in <span aria-hidden="true">↗</span></a><a href="/contact">Ask Crest about this film <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
  <section class="addons-section"><div class="intro"><span class="eyebrow">Protection add-ons</span><h2>Complete the<br /><em>system.</em></h2><p>Complete the Rodim system with ceramic coverage for PPF, glass, alloys, lights, grills, interiors and leather panels.</p></div><div class="addons-grid">{protectionAddOns.map((addon) => <article class="addon-card"><span>Protection add-on</span><h3>{addon.name}</h3><strong>{addon.total}<small>incl. GST</small></strong><div><span>Application</span><b>{addon.application}</b><span>GST</span><b>{addon.gst}</b><span>Warranty</span><b>{addon.warranty}</b></div><a href="/contact">Talk to Crest <span>↗</span></a></article>)}</div></section>
</SiteLayout>
<style>
  .protection-hero, .coating-section, .ppf-section, .addons-section { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .protection-hero { display: grid; grid-template-columns: 1fr .9fr; gap: 80px; align-items: center; min-height: 600px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--white); letter-spacing: -.06em; line-height: 1.05; }
  h1 { margin: 17px 0 24px; font-size: clamp(53px,7vw,88px); }
  h2 { margin: 13px 0 0; font-size: clamp(41px,5vw,64px); }
  .protection-hero p { max-width: 500px; margin-bottom: 31px; color: var(--muted); font-size: 16px; }
  .coating-section, .addons-section { max-width: none; background: #1b1b1d; }
  .intro, .coating-grid, .addons-grid { max-width: var(--max); margin-left: auto; margin-right: auto; }
  .intro { display: flex; align-items: end; justify-content: space-between; gap: 60px; margin-bottom: 45px; }
  .intro p { max-width: 345px; margin: 0; color: var(--muted); font-size: 14px; }
  .coating-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .coating-card { display: flex; min-height: 350px; flex-direction: column; padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease, box-shadow .25s ease; }
  .coating-card:hover, .coating-card.featured { border-color: rgba(59,130,246,.72); }
  .coating-card:hover { transform: translateY(-7px); box-shadow: 0 18px 45px rgba(0,0,0,.2); }
  .coating-card > span { color: var(--gold); font-size: 10px; font-weight: 700; }
  .coating-card h3 { margin: 43px 0 10px; font-size: 22px; }
  .coating-card p { color: var(--muted); font-size: 12px; }
  .coating-card strong { display: flex; align-items: baseline; gap: 7px; margin-top: auto; color: var(--white); font-size: 27px; }
  .coating-card strong small { color: #94a3b8; font-size: 9px; font-weight: 500; text-transform: uppercase; }
  .coating-card em { margin-top: 6px; color: var(--white); font-size: 10px; font-style: normal; }
  .coating-card a, .addon-card a { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .ppf-section { max-width: none; }
  .ppf-heading { max-width: var(--max); display: flex; justify-content: space-between; align-items: end; gap: 60px; margin: 0 auto 30px; }
  .ppf-heading p { max-width: 360px; margin: 0; color: var(--muted); font-size: 14px; }
  .ppf-list { max-width: var(--max); margin: 0 auto; border-top: 1px solid var(--line); }
  .ppf-list-item { display: grid; grid-template-columns: 50px 1fr auto; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .ppf-list-item > span { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .12em; }
  .ppf-list-item strong { color: var(--white); font-size: 18px; letter-spacing: -.03em; }
  .ppf-list-item a { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .ppf-list-item a span { margin-left: 7px; }

  .addons-section { padding-bottom: 125px; }
  .addons-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 13px; }
  .addon-card { padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease; }
  .addon-card:hover { transform: translateY(-6px); border-color: rgba(59,130,246,.72); }
  .addon-card > span { color: var(--gold); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .addon-card h3 { min-height: 58px; margin: 27px 0 10px; font-size: 20px; letter-spacing: -.04em; }
  .addon-card > strong { display: block; color: var(--white); font-size: 30px; letter-spacing: -.06em; }
  .addon-card > strong small { display: block; color: #94a3b8; font-size: 9px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; }
  .addon-card > div { display: grid; grid-template-columns: 1fr auto; gap: 8px 20px; margin-top: 22px; padding-top: 17px; border-top: 1px solid var(--line); }
  .addon-card > div span { color: #94a3b8; font-size: 10px; text-transform: uppercase; }
  .addon-card > div b { color: var(--gold-soft); font-size: 11px; }
  @media (max-width: 880px) { .protection-hero { grid-template-columns: 1fr; gap: 42px; } .intro, .ppf-heading { display: block; } .intro p, .ppf-heading p { margin-top: 20px; } .coating-grid { grid-template-columns: 1fr; } .coating-card { min-height: 270px; } }
</style>

<style is:global>
  /* Protection page only: the uploaded muted Rodim video is the sole background. */
  body:has(.protection-pinned-video), body:has(.protection-pinned-video) main { background: transparent !important; color: #fff !important; }
  body:has(.protection-pinned-video) .site-header, body:has(.protection-pinned-video) .site-header.is-scrolled { background: rgba(255,255,255,.76) !important; color: #0c2d4a !important; border-bottom-color: rgba(255,255,255,.72) !important; backdrop-filter: blur(22px) saturate(145%) !important; -webkit-backdrop-filter: blur(22px) saturate(145%) !important; }
  body:has(.protection-pinned-video) .site-footer { background: #0c2d4a !important; color: #fff !important; opacity: 1 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
  .protection-pinned-video { position: fixed; inset: 0; z-index: -2; width: 100vw; height: 100svh; object-fit: cover; pointer-events: none; background: #05080c; }
  .protection-hero, .protection-story, .coating-section, .ppf-section, .addons-section { position: relative; z-index: 1; background: transparent !important; color: #fff !important; }
  .protection-hero { min-height: 100svh !important; padding-top: 140px !important; padding-bottom: 100px !important; }
  .protection-hero > div, .protection-story-copy, .intro, .coating-card, .ppf-heading, .ppf-list, .ppf-list-item, .addon-card {
    background: rgba(5,10,16,.16) !important;
    border: 1px solid rgba(255,255,255,.25) !important;
    border-radius: 24px !important;
    box-shadow: inset 1px 1px rgba(255,255,255,.16), inset -1px -1px rgba(255,255,255,.03), 0 22px 65px rgba(0,0,0,.2) !important;
    backdrop-filter: blur(8px) saturate(110%) !important;
    -webkit-backdrop-filter: blur(8px) saturate(110%) !important;
  }
  .protection-hero > div:first-child, .protection-story-copy, .intro, .ppf-heading { padding: clamp(22px, 4vw, 42px) !important; }
  .protection-story { display: block !important; }
  .protection-story-copy { max-width: 720px !important; margin-left: auto; margin-right: auto; }
  .coating-section, .ppf-section, .addons-section { max-width: none !important; padding-top: 120px !important; padding-bottom: 120px !important; }
  .coating-grid, .addons-grid { gap: 16px !important; }
  .coating-card, .addon-card { padding: clamp(20px, 3vw, 30px) !important; }
  .ppf-list { padding: 0 22px !important; border-top: 0 !important; }
  .ppf-list-item { padding: 20px !important; margin: 14px 0; }
  .protection-pinned-video ~ *, .protection-pinned-video ~ * * { color: #fff !important; }
  .protection-pinned-video ~ * em, .protection-pinned-video ~ * .eyebrow, .protection-pinned-video ~ * .film-index, .protection-pinned-video ~ * .film-warranty { color: #f0b275 !important; }
  .protection-pinned-video ~ * p, .protection-pinned-video ~ * small, .protection-pinned-video ~ * span { color: rgba(255,255,255,.88) !important; }
  .protection-pinned-video ~ * .button-gold { background: rgba(255,255,255,.9) !important; color: #081018 !important; }
  .protection-float-in { opacity: 0; transform: translate3d(0, 42px, 0) scale(.985); transition: opacity .8s ease, transform .9s cubic-bezier(.22,1,.36,1); }
  .protection-float-in.is-visible { opacity: 1; transform: none; }
  @media (max-width: 880px) { .protection-hero { grid-template-columns: 1fr !important; gap: 24px !important; } }
  @media (max-width: 620px) {
    .protection-hero, .protection-story, .coating-section, .ppf-section, .addons-section { padding: 82px 16px !important; }
    .protection-hero { min-height: 100svh !important; padding-top: 110px !important; }
    .protection-hero > div, .protection-story-copy, .intro, .coating-card, .ppf-heading, .ppf-list, .ppf-list-item, .addon-card { border-radius: 20px !important; }
    .protection-hero > div:first-child, .protection-story-copy, .intro, .ppf-heading { padding: 20px !important; }
    .ppf-list { padding: 0 12px !important; }
    .protection-float-in { transform: translate3d(0, 28px, 0) scale(.99); }
  }
  @media (prefers-reduced-motion: reduce) { .protection-float-in { opacity: 1; transform: none; transition: none; } }
</style>
<script>
  const protectionVideo = document.querySelector('.protection-pinned-video');
  if (protectionVideo instanceof HTMLVideoElement) { protectionVideo.muted = true; protectionVideo.defaultMuted = true; protectionVideo.volume = 0; protectionVideo.setAttribute('muted', ''); protectionVideo.addEventListener('volumechange', () => { protectionVideo.muted = true; protectionVideo.volume = 0; }); }
  const protectionCards = document.querySelectorAll('.protection-hero > div, .protection-story-copy, .coating-section .intro, .coating-card, .ppf-heading, .ppf-list-item, .addons-section .intro, .addon-card');
  protectionCards.forEach((card) => card.classList.add('protection-float-in'));
  const protectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting)), { rootMargin: '0px 0px -12% 0px', threshold: .08 });
  protectionCards.forEach((card) => protectionObserver.observe(card));
</script>

<style is:global>
  /* Clear crystal treatment: no card fill, only glass edges over the pinned video. */
  body:has(.protection-pinned-video) .protection-hero > div,
  body:has(.protection-pinned-video) .protection-story-copy,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .coating-card,
  body:has(.protection-pinned-video) .ppf-heading,
  body:has(.protection-pinned-video) .ppf-list,
  body:has(.protection-pinned-video) .ppf-list-item,
  body:has(.protection-pinned-video) .addon-card {
    background: transparent !important;
    box-shadow: inset 1px 1px rgba(255,255,255,.38), inset -1px -1px rgba(255,255,255,.1) !important;
    border-color: rgba(255,255,255,.42) !important;
    backdrop-filter: blur(3px) saturate(125%) !important;
    -webkit-backdrop-filter: blur(3px) saturate(125%) !important;
  }
  body:has(.protection-pinned-video) .protection-hero > div,
  body:has(.protection-pinned-video) .protection-story-copy,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .coating-card,
  body:has(.protection-pinned-video) .ppf-heading,
  body:has(.protection-pinned-video) .ppf-list,
  body:has(.protection-pinned-video) .ppf-list-item,
  body:has(.protection-pinned-video) .addon-card,
  body:has(.protection-pinned-video) .protection-hero h1,
  body:has(.protection-pinned-video) .protection-hero h2,
  body:has(.protection-pinned-video) .protection-hero p,
  body:has(.protection-pinned-video) .protection-story-copy h2,
  body:has(.protection-pinned-video) .protection-story-copy p,
  body:has(.protection-pinned-video) .intro h2,
  body:has(.protection-pinned-video) .intro p,
  body:has(.protection-pinned-video) .ppf-heading h2,
  body:has(.protection-pinned-video) .ppf-heading p,
  body:has(.protection-pinned-video) .coating-card *,
  body:has(.protection-pinned-video) .ppf-list-item *,
  body:has(.protection-pinned-video) .addon-card * { color: #fff !important; -webkit-text-fill-color: #fff !important; }
  body:has(.protection-pinned-video) .protection-hero h1 em,
  body:has(.protection-pinned-video) .protection-story-copy h2 em,
  body:has(.protection-pinned-video) .intro h2 em,
  body:has(.protection-pinned-video) .eyebrow { color: #fff !important; }
</style>

<style is:global>
  /* Final transparent-card pass: no fill, no blur, no competing section backgrounds. */
  body:has(.protection-pinned-video),
  body:has(.protection-pinned-video) main,
  body:has(.protection-pinned-video) .protection-hero,
  body:has(.protection-pinned-video) .protection-story,
  body:has(.protection-pinned-video) .coating-section,
  body:has(.protection-pinned-video) .ppf-section,
  body:has(.protection-pinned-video) .addons-section,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .ppf-list { background: transparent !important; }
  body:has(.protection-pinned-video) main { position: relative !important; isolation: isolate !important; }
  body:has(.protection-pinned-video) .protection-pinned-video { z-index: 0 !important; }
  body:has(.protection-pinned-video) .protection-hero,
  body:has(.protection-pinned-video) .protection-story,
  body:has(.protection-pinned-video) .coating-section,
  body:has(.protection-pinned-video) .ppf-section,
  body:has(.protection-pinned-video) .addons-section { z-index: 1 !important; }
  body:has(.protection-pinned-video) .protection-hero > div,
  body:has(.protection-pinned-video) .protection-story-copy,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .coating-card,
  body:has(.protection-pinned-video) .ppf-heading,
  body:has(.protection-pinned-video) .ppf-list,
  body:has(.protection-pinned-video) .ppf-list-item,
  body:has(.protection-pinned-video) .addon-card {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
    border: 1px solid rgba(255,255,255,.62) !important;
  }
  body:has(.protection-pinned-video) .protection-hero > div,
  body:has(.protection-pinned-video) .protection-story-copy,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .ppf-heading,
  body:has(.protection-pinned-video) .coating-card,
  body:has(.protection-pinned-video) .ppf-list,
  body:has(.protection-pinned-video) .ppf-list-item,
  body:has(.protection-pinned-video) .addon-card { color: #fff !important; }
  body:has(.protection-pinned-video) .protection-hero > div *,
  body:has(.protection-pinned-video) .protection-story-copy *,
  body:has(.protection-pinned-video) .intro *,
  body:has(.protection-pinned-video) .ppf-heading *,
  body:has(.protection-pinned-video) .coating-card *,
  body:has(.protection-pinned-video) .ppf-list-item *,
  body:has(.protection-pinned-video) .addon-card * { color: #fff !important; -webkit-text-fill-color: #fff !important; text-shadow: 0 2px 16px rgba(0,0,0,.8); }
</style>

<style is:global>
  /* Protection page typography: use Crest's established deep blue #123d66. */
  body:has(.protection-pinned-video) .protection-hero > div *,
  body:has(.protection-pinned-video) .protection-story-copy *,
  body:has(.protection-pinned-video) .intro *,
  body:has(.protection-pinned-video) .ppf-heading *,
  body:has(.protection-pinned-video) .coating-card *,
  body:has(.protection-pinned-video) .ppf-list-item *,
  body:has(.protection-pinned-video) .addon-card * { color: #123d66 !important; -webkit-text-fill-color: #123d66 !important; text-shadow: none !important; }
  body:has(.protection-pinned-video) .protection-hero h1 em,
  body:has(.protection-pinned-video) .protection-story-copy h2 em,
  body:has(.protection-pinned-video) .intro h2 em,
  body:has(.protection-pinned-video) .eyebrow { color: #123d66 !important; }
  body:has(.protection-pinned-video) .protection-hero .button-gold { color: #123d66 !important; -webkit-text-fill-color: #123d66 !important; }
</style>

<style is:global>
  /* Protection cards: transparent by default, white glass surface on hover. */
  body:has(.protection-pinned-video) .protection-hero > div,
  body:has(.protection-pinned-video) .protection-story-copy,
  body:has(.protection-pinned-video) .intro,
  body:has(.protection-pinned-video) .coating-card,
  body:has(.protection-pinned-video) .ppf-heading,
  body:has(.protection-pinned-video) .ppf-list-item,
  body:has(.protection-pinned-video) .addon-card { transition: background-color .28s ease, border-color .28s ease, color .28s ease, transform .28s ease; }
  body:has(.protection-pinned-video) .protection-hero > div:hover,
  body:has(.protection-pinned-video) .protection-story-copy:hover,
  body:has(.protection-pinned-video) .intro:hover,
  body:has(.protection-pinned-video) .coating-card:hover,
  body:has(.protection-pinned-video) .ppf-heading:hover,
  body:has(.protection-pinned-video) .ppf-list-item:hover,
  body:has(.protection-pinned-video) .addon-card:hover { background: rgba(255,255,255,.94) !important; border-color: #fff !important; color: #123d66 !important; transform: translateY(-4px); }
  body:has(.protection-pinned-video) .protection-hero > div:hover *,
  body:has(.protection-pinned-video) .protection-story-copy:hover *,
  body:has(.protection-pinned-video) .intro:hover *,
  body:has(.protection-pinned-video) .coating-card:hover *,
  body:has(.protection-pinned-video) .ppf-heading:hover *,
  body:has(.protection-pinned-video) .ppf-list-item:hover *,
  body:has(.protection-pinned-video) .addon-card:hover * { color: #123d66 !important; -webkit-text-fill-color: #123d66 !important; text-shadow: none !important; }
  body:has(.protection-pinned-video) .protection-hero > div:hover h1 em,
  body:has(.protection-pinned-video) .protection-story-copy:hover h2 em,
  body:has(.protection-pinned-video) .intro:hover h2 em,
  body:has(.protection-pinned-video) .eyebrow { color: #123d66 !important; }
</style>
