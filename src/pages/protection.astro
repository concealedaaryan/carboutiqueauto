---
import SiteLayout from '../layouts/SiteLayout.astro';
import { coatingPackages, ppfOptions, protectionAddOns } from '../data/catalog';
---
<SiteLayout title="Rodim PPF and Ceramic Coatings in DLF Gurugram" description="Compare Rodim PPF, ceramic coating, graphene and surface-protection options from Crest Automotive Care in DLF Gurugram." currentPath="/protection" pageNumber="03" pageLabel="Surface protection">
  <section class="protection-hero"><div><span class="eyebrow">Crest Automotive Care · Rodim PPF</span><h1>More gloss.<br /><em>More protection.</em></h1><p>Crest helps you compare Rodim paint protection films and plan an installation around your vehicle, paint condition and intended coverage.</p><a class="button button-gold" href="/estimate">Build a Rodim PPF estimate <span>↗</span></a></div><div class="hero-image rodim-hero-image"><span>RODIM PPF · SURFACE DEFENSE</span><small>Precision film installation / Crest private bay</small></div></section>
  <section class="protection-story"><div class="protection-story-image" aria-hidden="true"></div><div class="protection-story-copy"><span class="eyebrow">The Rodim approach</span><h2>Film first.<br /><em>Finish second.</em></h2><p>Rodim PPF works best as a considered system: prepare the surface, install the right film, then maintain the finish with coatings and careful aftercare.</p><div class="protection-beats"><div><strong>Prepare</strong><span>Paint condition and coverage come first.</span></div><div><strong>Protect</strong><span>Rodim PPF takes the road impact.</span></div><div><strong>Maintain</strong><span>Coatings keep the finish easier to live with.</span></div></div></div></section>
  <section class="coating-section" id="ceramic"><div class="intro"><span class="eyebrow">Ceramic & graphene</span><h2>Surface confidence,<br /><em>layer by layer.</em></h2><p>Choose from nano ceramic, premium ceramic or premium graphene treatments. The exact process depends on paint condition, prior repairs, model and agreed scope.</p></div><div class="coating-grid">{coatingPackages.map((pkg, index) => <article class={`coating-card ${index === 2 ? 'featured' : ''}`}><h3>{pkg.name}</h3><p>{index === 0 ? 'Entry protection for a cleaner, glossier daily finish.' : index === 1 ? 'Correction-led premium ceramic with glass, trim and interior care.' : 'Graphene protection with correction, glass and alloy protection.'}</p><strong>{pkg.prices[0]}<small>from</small></strong><em>{pkg.warranty}</em><a href={`/estimate?service=${index === 0 ? '11' : index === 1 ? '12' : '13'}`}>Estimate this coating <span>↗</span></a></article>)}</div></section>
  <section class="ppf-section"><div class="ppf-heading"><div><span class="eyebrow">Rodim paint protection film</span><h2>Choose your Rodim shield.</h2></div><p>Rodim thermoplastic paint protection film, described by Crest as manufactured using BASF technology, helps defend against scratches, swirl marks, road debris and environmental wear. Compare the available Rodim film variants with the Crest team, then confirm the right film and coverage for your vehicle. Verify the BASF relationship against current supplier documentation before publication.</p></div><div class="ppf-list" aria-label="Rodim paint protection film variants">{ppfOptions.filter((film) => film.officialProduct).map((film, index) => <article class="ppf-list-item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{film.name}</strong><div><a href={film.officialUrl} target="_blank" rel="noopener noreferrer">View {film.name} on Rodim.in <span aria-hidden="true">↗</span></a><a href="/contact">Ask Crest about this film <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
  <section class="addons-section"><div class="intro"><span class="eyebrow">Protection add-ons</span><h2>Complete the<br /><em>system.</em></h2><p>Complete the Rodim system with ceramic coverage for PPF, glass, alloys, lights, grills, interiors and leather panels.</p></div><div class="addons-grid">{protectionAddOns.map((addon) => <article class="addon-card"><span>Protection add-on</span><h3>{addon.name}</h3><strong>{addon.total}<small>incl. GST</small></strong><div><span>Application</span><b>{addon.application}</b><span>GST</span><b>{addon.gst}</b><span>Warranty</span><b>{addon.warranty}</b></div><a href="/contact">Talk to Crest <span>↗</span></a></article>)}</div></section>
</SiteLayout>
<style>
  .protection-hero, .coating-section, .ppf-section, .addons-section { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .protection-hero { display: grid; grid-template-columns: 1fr .9fr; gap: 80px; align-items: center; min-height: 600px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--white); letter-spacing: -.06em; line-height: 1.05; }
  h1 { margin: 17px 0 24px; font-size: clamp(53px,7vw,88px); }
  h2 { margin: 13px 0 0; font-size: clamp(41px,5vw,64px); }
  .protection-hero p { max-width: 500px; margin-bottom: 31px; color: var(--muted); font-size: 16px; }
  .hero-image { min-height: 450px; display: flex; flex-direction: column; justify-content: end; padding: 24px; border: 1px solid var(--line); background-size: cover; background-position: center; }
  .rodim-hero-image { background-image: linear-gradient(180deg, rgba(14,14,16,.12), rgba(14,14,16,.88)), url('/images/generated/crest-ppf-precision.jpg'); background-position: center; background-size: cover; }
  .hero-image span, .hero-image small { color: var(--white); font-size: 10px; font-weight: 700; letter-spacing: .13em; }
  .hero-image small { margin-top: 7px; color: #c1ccdb; font-size: 9px; letter-spacing: .02em; }
  .coating-section, .addons-section { max-width: none; background: #1b1b1d; }
  .intro, .coating-grid, .addons-grid { max-width: var(--max); margin-left: auto; margin-right: auto; }
  .intro { display: flex; align-items: end; justify-content: space-between; gap: 60px; margin-bottom: 45px; }
  .intro p { max-width: 345px; margin: 0; color: var(--muted); font-size: 14px; }
  .coating-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .coating-card { display: flex; min-height: 350px; flex-direction: column; padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease, box-shadow .25s ease; }
  .coating-card:hover, .coating-card.featured { border-color: rgba(59,130,246,.72); }
  .coating-card:hover { transform: translateY(-7px); box-shadow: 0 18px 45px rgba(0,0,0,.2); }
  .coating-card > span { color: var(--gold); font-size: 10px; font-weight: 700; }
  .coating-card h3 { margin: 43px 0 10px; font-size: 22px; }
  .coating-card p { color: var(--muted); font-size: 12px; }
  .coating-card strong { display: flex; align-items: baseline; gap: 7px; margin-top: auto; color: var(--white); font-size: 27px; }
  .coating-card strong small { color: #94a3b8; font-size: 9px; font-weight: 500; text-transform: uppercase; }
  .coating-card em { margin-top: 6px; color: var(--white); font-size: 10px; font-style: normal; }
  .coating-card a, .addon-card a { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .ppf-section { max-width: none; }
  .ppf-heading { max-width: var(--max); display: flex; justify-content: space-between; align-items: end; gap: 60px; margin: 0 auto 30px; }
  .ppf-heading p { max-width: 360px; margin: 0; color: var(--muted); font-size: 14px; }
  .ppf-list { max-width: var(--max); margin: 0 auto; border-top: 1px solid var(--line); }
  .ppf-list-item { display: grid; grid-template-columns: 50px 1fr auto; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .ppf-list-item > span { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .12em; }
  .ppf-list-item strong { color: var(--white); font-size: 18px; letter-spacing: -.03em; }
  .ppf-list-item a { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .ppf-list-item a span { margin-left: 7px; }

  .addons-section { padding-bottom: 125px; }
  .addons-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 13px; }
  .addon-card { padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease; }
  .addon-card:hover { transform: translateY(-6px); border-color: rgba(59,130,246,.72); }
  .addon-card > span { color: var(--gold); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .addon-card h3 { min-height: 58px; margin: 27px 0 10px; font-size: 20px; letter-spacing: -.04em; }
  .addon-card > strong { display: block; color: var(--white); font-size: 30px; letter-spacing: -.06em; }
  .addon-card > strong small { display: block; color: #94a3b8; font-size: 9px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; }
  .addon-card > div { display: grid; grid-template-columns: 1fr auto; gap: 8px 20px; margin-top: 22px; padding-top: 17px; border-top: 1px solid var(--line); }
  .addon-card > div span { color: #94a3b8; font-size: 10px; text-transform: uppercase; }
  .addon-card > div b { color: var(--gold-soft); font-size: 11px; }
  @media (max-width: 880px) { .protection-hero { grid-template-columns: 1fr; gap: 42px; } .intro, .ppf-heading { display: block; } .intro p, .ppf-heading p { margin-top: 20px; } .coating-grid { grid-template-columns: 1fr; } .coating-card { min-height: 270px; } }
  @media (max-width: 620px) { .protection-hero, .coating-section, .ppf-section, .addons-section { padding: 80px 20px; } .protection-hero { min-height: auto; padding-top: 88px; } .hero-image { min-height: 330px; } .addons-grid { grid-template-columns: 1fr; } .ppf-list-item { grid-template-columns: 34px 1fr; gap: 12px; } .ppf-list-item a { grid-column: 2; } }
</style>
