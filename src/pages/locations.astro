---
import SiteLayout from '../layouts/SiteLayout.astro';
import ImageCard from '../components/ImageCard.astro';
const locations = [
  { name: 'DLF Crest', detail: 'The home of Crest Automotive Care Studio.' },
  { name: 'DLF The Camellias', detail: 'In-house premium car care for residents.' },
  { name: 'DLF The Magnolias', detail: 'Community-first detailing at your doorstep.' },
];
const locationMaps = [
  { name: 'DLF Crest', detail: 'Crest Automotive Care Solutions LLP', embed: 'https://www.google.com/maps?q=28.4456252,77.1128288&z=17&output=embed', link: 'https://maps.app.goo.gl/JquGbKaqvJ6Xy1tJA' },
  { name: 'DLF The Camellias', detail: 'Community location pin', embed: 'https://www.google.com/maps?q=28.4507956,77.1005205&z=17&output=embed', link: 'https://maps.app.goo.gl/zmkrjvHQAQFGCLT86' },
  { name: 'DLF The Magnolias', detail: 'Community location pin', embed: 'https://www.google.com/maps?q=28.4572893,77.0998467&z=17&output=embed', link: 'https://maps.app.goo.gl/H7wck8Lde2BkmnVK7' },
];
---
<SiteLayout title="Crest Automotive Care Locations in DLF Gurugram" description="Find Crest Automotive Care at DLF Crest, DLF The Camellias and DLF The Magnolias, with premium in-house car detailing and protection in DLF Gurugram." currentPath="/locations" pageNumber="05" pageLabel="Find us in-house">
  <section class="location-hero"><div><span class="eyebrow">Find us in-house</span><h1>Care that comes<br /><em>to your doorstep.</em></h1><p>Exclusively serving residents of three DLF communities. Your car stays close while our trained team takes care of it.</p><a class="button button-gold" href="/contact">Contact the team <span>↗</span></a></div><div class="map-wrap"><iframe title="Google Maps location for DLF Crest Gurugram" src="https://www.google.com/maps?q=28.4456252,77.1128288&z=17&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><div class="map-label"><span>+</span><strong>DLF Crest</strong><small>In-house premium car care</small></div></div></section>
  <section class="location-studio"><ImageCard src="/images/drive/led-headlight.jpeg" alt="Graphite sedan inside a premium automotive detailing studio in DLF Gurugram" eyebrow="Crest Automotive Care Studio" title="Private care, close to home." caption="Serving DLF The Camellias, DLF Crest and DLF The Magnolias." /><div><span class="eyebrow">Local, by design</span><h2>Premium car detailing<br /><em>in DLF Gurugram.</em></h2><p>Crest Automotive Care is an in-house detailing studio for residents of DLF The Camellias, DLF Crest and DLF The Magnolias. Our waterless wash, paint protection and maintenance plans are designed around the way cars are used in Gurugram: close to home, easy to schedule and careful with the finish.</p><a class="text-action" href="/services">Explore the treatment menu <span>→</span></a></div></section>
  <section class="location-maps-section"><div class="section-heading"><div><span class="eyebrow">Map pins</span><h2>Find each<br /><em>community.</em></h2></div><p>Open the map for the exact pin. DLF Crest is shown first, followed by DLF The Camellias and DLF The Magnolias.</p></div><div class="location-map-grid">{locationMaps.map((location) => <article class="location-map-card"><iframe title={`Google Maps location for ${location.name}`} src={location.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><div class="location-map-copy"><div><h3>{location.name}</h3><p>{location.detail}</p></div><a href={location.link} target="_blank" rel="noopener noreferrer" aria-label={`Open ${location.name} in Google Maps`}>Open pin <span>↗</span></a></div></article>)}</div></section>
  <section class="locations-section"><div class="section-heading"><div><span class="eyebrow">Three communities</span><h2>Near the car.<br /><em>Close to home.</em></h2></div><p>Service timings are 5 AM–6 PM daily. Share your community and model when enquiring so we can confirm availability.</p></div><div class="location-grid">{locations.map((location) => <article><h3>{location.name}</h3><p>{location.detail}</p><a href={`/contact?community=${encodeURIComponent(location.name)}`}>Ask about availability <span>→</span></a></article>)}</div></section>
  <section class="location-cta"><span class="eyebrow">Need a hand?</span><h2>Call before you<br /><em>drive over.</em></h2><div><a href="tel:+919871610952">+91 98716 10952</a><a href="tel:+919810528263">+91 98105 28263</a></div></section>
</SiteLayout>
<style>
  .location-hero, .locations-section, .location-cta { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .location-maps-section { max-width: none; padding: 110px 24px; background: #1b1b1d; }
  .location-map-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: var(--max); margin: 0 auto; }
  .location-map-card { overflow: hidden; border: 1px solid var(--line); background: #0d2440; }
  .location-map-card iframe { display: block; width: 100%; height: 300px; border: 0; filter: grayscale(1) contrast(1.05) brightness(.76) sepia(.15); }
  .location-map-copy { display: flex; align-items: end; justify-content: space-between; gap: 18px; padding: 20px; }
  .location-map-copy h3 { margin: 0; color: var(--white); font-size: 19px; }
  .location-map-copy p { margin: 6px 0 0; color: var(--muted); font-size: 11px; }
  .location-map-copy a { flex-shrink: 0; color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .location-hero { display: grid; grid-template-columns: 1fr 1.05fr; gap: 75px; align-items: center; min-height: 620px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--white); line-height: 1.05; letter-spacing: -.06em; }
  h1 { margin: 18px 0 24px; font-size: clamp(52px,6vw,84px); }
  h2 { margin: 12px 0 0; font-size: clamp(42px,5vw,65px); }
  .location-hero p { max-width: 480px; margin-bottom: 32px; color: var(--muted); font-size: 16px; }
  .map-wrap { position: relative; min-height: 435px; overflow: hidden; border: 1px solid var(--line); background: #0d2440; }
  .map-wrap iframe { width: 100%; height: 435px; border: 0; filter: grayscale(1) contrast(1.05) brightness(.76) sepia(.15); }
  .map-label { position: absolute; left: 22px; bottom: 22px; display: grid; grid-template-columns: 32px 1fr; gap: 3px 10px; align-items: center; padding: 13px 16px; background: rgba(19,19,21,.91); border: 1px solid rgba(59,130,246,.4); backdrop-filter: blur(12px); }
  .map-label span { grid-row: 1 / 3; display: grid; place-items: center; width: 26px; height: 26px; color: var(--gold); border: 1px solid var(--gold); }
  .map-label strong { color: var(--white); font-size: 12px; }
  .map-label small { color: #a9b6c8; font-size: 9px; }
  .location-studio { display:grid; grid-template-columns:1fr 1fr; gap:70px; align-items:center; max-width:var(--max); margin:0 auto; padding:110px 24px; }
  .location-studio .image-card, .location-studio .image-card img { min-height:380px; }
  .location-studio h2 { margin:15px 0 20px; color:var(--white); font-size:clamp(38px,4.5vw,58px); line-height:1.05; letter-spacing:-.06em; }
  .location-studio p { max-width:500px; color:var(--white); font-size:15px; line-height:1.75; }
  .text-action { display:inline-flex; gap:10px; margin-top:22px; color:var(--gold-soft); font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .locations-section { max-width: none; background-image: linear-gradient(90deg, rgba(14,14,16,.95), rgba(27,27,29,.8)), url('/images/drive/black-sports-car.jpeg'); background-position:center; background-size:cover; }
  .section-heading, .location-grid { max-width: var(--max); margin-left: auto; margin-right: auto; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 55px; margin-bottom: 48px; }
  .section-heading p { max-width: 340px; margin: 0; color: var(--muted); font-size: 14px; }
  .location-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .location-grid article { min-height: 230px; padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease; }
  .location-grid article:hover { transform: translateY(-6px); border-color: rgba(59,130,246,.7); }
  .location-grid h3 { margin: 42px 0 10px; font-size: 22px; }
  .location-grid p { margin: 0 0 24px; color: var(--muted); font-size: 12px; }
  .location-grid a { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .location-cta { display: flex; align-items: end; justify-content: space-between; gap: 40px; }
  .location-cta h2 { margin-right: auto; }
  .location-cta > div { display: grid; gap: 9px; }
  .location-cta > div a { color: var(--gold-soft); font-size: 17px; font-weight: 600; }
  @media (max-width: 1050px) { .location-map-grid { grid-template-columns: 1fr; } .location-map-card iframe { height: 330px; } }
  @media (max-width: 850px) { .location-hero { grid-template-columns: 1fr; gap: 45px; } .location-studio { grid-template-columns:1fr; gap:38px; } .section-heading { display: block; } .section-heading p { margin-top: 22px; } .location-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .location-hero, .location-studio, .locations-section, .location-cta, .location-maps-section { padding: 80px 20px; } .location-hero { min-height: auto; padding-top: 88px; } .map-wrap, .map-wrap iframe { min-height: 330px; height: 330px; } .location-map-card iframe { height: 280px; } .location-map-copy { display: block; } .location-map-copy a { display: inline-block; margin-top: 14px; } .location-cta { display: block; } .location-cta > div { margin-top: 28px; } }
</style>
