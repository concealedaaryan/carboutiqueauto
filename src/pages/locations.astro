---
import SiteLayout from '../layouts/SiteLayout.astro';
const locations = [
  { number: '01', name: 'The Camellias', detail: 'In-house premium car care for residents.' },
  { number: '02', name: 'The Crest', detail: 'The home of Crest Automotive Studio.' },
  { number: '03', name: 'The Magnolias', detail: 'Community-first detailing at your doorstep.' },
];
---
<SiteLayout title="Locations" description="Crest Automotive in-house service locations across The Camellias, The Crest and The Magnolias." currentPath="/locations" pageNumber="05" pageLabel="Find us in-house">
  <section class="location-hero"><div><span class="eyebrow">05 / Find us in-house</span><h1>Care that comes<br /><em>to your doorstep.</em></h1><p>Exclusively serving residents of three DLF communities. Your car stays close while our trained team takes care of it.</p><a class="button button-gold" href="/contact">Contact the team <span>↗</span></a></div><div class="map-wrap"><iframe title="Google Maps location for The Crest DLF Gurugram" src="https://www.google.com/maps?q=The%20Crest%20DLF%20Gurugram&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><div class="map-label"><span>+</span><strong>DLF Gurugram</strong><small>In-house premium car care</small></div></div></section>
  <section class="locations-section"><div class="section-heading"><div><span class="eyebrow">Three communities</span><h2>Near the car.<br /><em>Close to home.</em></h2></div><p>Service timings are 5 AM–6 PM daily. Share your community and model when enquiring so we can confirm availability.</p></div><div class="location-grid">{locations.map((location) => <article><span>{location.number}</span><h3>{location.name}</h3><p>{location.detail}</p><a href={`/contact?community=${encodeURIComponent(location.name)}`}>Ask about availability <span>→</span></a></article>)}</div></section>
  <section class="location-cta"><span class="eyebrow">Need a hand?</span><h2>Call before you<br /><em>drive over.</em></h2><div><a href="tel:+919871610952">+91 98716 10952</a><a href="tel:+919810528263">+91 98105 28263</a></div></section>
</SiteLayout>
<style>
  .location-hero, .locations-section, .location-cta { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .location-hero { display: grid; grid-template-columns: 1fr 1.05fr; gap: 75px; align-items: center; min-height: 620px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--white); line-height: 1.05; letter-spacing: -.06em; }
  h1 { margin: 18px 0 24px; font-size: clamp(52px,6vw,84px); }
  h2 { margin: 12px 0 0; font-size: clamp(42px,5vw,65px); }
  em { color: var(--gold-soft); font-style: normal; }
  .location-hero p { max-width: 480px; margin-bottom: 32px; color: var(--muted); font-size: 16px; }
  .map-wrap { position: relative; min-height: 435px; overflow: hidden; border: 1px solid var(--line); background: #0d2440; }
  .map-wrap iframe { width: 100%; height: 435px; border: 0; filter: grayscale(1) contrast(1.05) brightness(.76) sepia(.15); }
  .map-label { position: absolute; left: 22px; bottom: 22px; display: grid; grid-template-columns: 32px 1fr; gap: 3px 10px; align-items: center; padding: 13px 16px; background: rgba(7,21,40,.91); border: 1px solid rgba(226,185,104,.4); backdrop-filter: blur(12px); }
  .map-label span { grid-row: 1 / 3; display: grid; place-items: center; width: 26px; height: 26px; color: var(--gold); border: 1px solid var(--gold); }
  .map-label strong { color: var(--white); font-size: 12px; }
  .map-label small { color: #a9b6c8; font-size: 9px; }
  .locations-section { max-width: none; background: #0a1d35; }
  .section-heading, .location-grid { max-width: var(--max); margin-left: auto; margin-right: auto; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 55px; margin-bottom: 48px; }
  .section-heading p { max-width: 340px; margin: 0; color: var(--muted); font-size: 14px; }
  .location-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13px; }
  .location-grid article { min-height: 230px; padding: 25px; border: 1px solid var(--line); background: #0d2440; transition: transform .3s var(--ease), border-color .25s ease; }
  .location-grid article:hover { transform: translateY(-6px); border-color: rgba(226,185,104,.7); }
  .location-grid article > span { color: var(--gold); font-size: 10px; font-weight: 700; }
  .location-grid h3 { margin: 42px 0 10px; font-size: 22px; }
  .location-grid p { margin: 0 0 24px; color: var(--muted); font-size: 12px; }
  .location-grid a { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .location-cta { display: flex; align-items: end; justify-content: space-between; gap: 40px; }
  .location-cta h2 { margin-right: auto; }
  .location-cta > div { display: grid; gap: 9px; }
  .location-cta > div a { color: var(--gold-soft); font-size: 17px; font-weight: 600; }
  @media (max-width: 850px) { .location-hero { grid-template-columns: 1fr; gap: 45px; } .section-heading { display: block; } .section-heading p { margin-top: 22px; } .location-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .location-hero, .locations-section, .location-cta { padding: 80px 20px; } .location-hero { min-height: auto; padding-top: 88px; } .map-wrap, .map-wrap iframe { min-height: 330px; height: 330px; } .location-cta { display: block; } .location-cta > div { margin-top: 28px; } }
</style>
