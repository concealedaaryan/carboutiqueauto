---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found" description="The Crest Automotive Care page could not be found. Explore services, packages, protection and estimates." currentPath="/" pageNumber="" robots="noindex,follow" includeBusinessSchema={false}>
  <section class="not-found-page">
    <div class="not-found-copy">
      <span class="eyebrow">Crest / 404</span>
      <h1>Page not found.</h1>
      <p>The page you’re looking for has moved, gone off-road, or never existed. Let’s get you back to the finish line.</p>
      <div class="not-found-actions">
        <a class="button button-gold" href="/">Back to home <span>→</span></a>
        <a class="button button-ghost" href="/estimate">Build an estimate <span>↗</span></a>
      </div>
      <p class="not-found-help">Looking for a specific service? <a href="/services">Browse all services</a> or <a href="/contact">contact the Crest team</a>.</p>
    </div>
    <div class="not-found-mark" aria-hidden="true"><strong>404</strong><span>OUT OF ROUTE</span><small>CREST AUTOMOTIVE CARE</small></div>
  </section>
</SiteLayout>
<style>
  .not-found-page { max-width: var(--max); min-height: 650px; margin: 0 auto; padding: 180px 24px 120px; display: grid; grid-template-columns: 1.1fr .9fr; gap: 80px; align-items: center; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 18px 0 22px; color: var(--white); font-size: clamp(54px, 7vw, 92px); line-height: 1; letter-spacing: -.07em; }
  .not-found-copy > p { max-width: 560px; color: var(--muted); font-size: 16px; }
  .not-found-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .not-found-help { margin-top: 26px; font-size: 12px !important; }
  .not-found-help a { color: var(--gold-soft); font-weight: 600; }
  .not-found-mark { display: grid; min-height: 300px; place-items: center; align-content: center; gap: 12px; border: 1px solid var(--line); background: radial-gradient(circle at 50% 40%, rgba(59,130,246,.16), transparent 55%), #0d2440; }
  .not-found-mark strong { color: var(--gold-soft); font-size: clamp(80px, 11vw, 150px); letter-spacing: -.1em; line-height: .8; }
  .not-found-mark span, .not-found-mark small { color: #a9b6c8; font-size: 10px; font-weight: 700; letter-spacing: .16em; }
  .not-found-mark small { color: var(--gold); font-size: 8px; }
  @media (max-width: 700px) { .not-found-page { min-height: auto; padding: 150px 20px 90px; grid-template-columns: 1fr; gap: 45px; } .not-found-actions { display: grid; } .not-found-actions .button { width: 100%; } .not-found-mark { min-height: 220px; } }
</style>
