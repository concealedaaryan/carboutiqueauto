---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact Crest Automotive Care in DLF Gurugram" description="Contact Crest Automotive Care to enquire about premium detailing, Rodim PPF, coatings, packages and in-house service across DLF Gurugram." currentPath="/contact" pageNumber="07" pageLabel="Start a conversation">
  <section class="contact-hero"><div><span class="eyebrow">Start a conversation</span><h1>Ready for a<br /><em>better finish?</em></h1><p>Tell us your car model, preferred service and community. Our team will get back to confirm availability and the right treatment tier.</p><div class="contact-details"><a href="tel:+919871610952"><small>Ruchir Malhotra</small>+91 98716 10952</a><a href="tel:+919810528263"><small>Ranjeev Kapoor</small>+91 98105 28263</a><a href="https://wa.me/919871610952" target="_blank" rel="noopener noreferrer"><small>Fastest chat</small>WhatsApp ↗</a></div></div><div class="contact-card"><span class="eyebrow">Send an enquiry</span><div class="estimate-context" id="estimate-context" hidden><span class="eyebrow">Your estimate</span><strong id="estimate-context-service"></strong><small id="estimate-context-category"></small><small id="estimate-context-total"></small><p>Keep this summary open while submitting the Google Form so the Crest team can confirm the same treatment and indicative total.</p></div><div class="form-embed"><iframe title="Crest Automotive Care contact form" src="https://docs.google.com/forms/d/e/1FAIpQLScfGVnQfqiPPrO7zjN1qMx7BHIyogQsZHhRjLUN5yUHLEgJ3Q/viewform?embedded=true" loading="lazy">Loading…</iframe></div><p class="form-note">Your enquiry will be sent through Google Forms. If you need an immediate response, call or WhatsApp the team above.</p><a class="form-fallback" href="https://docs.google.com/forms/d/e/1FAIpQLScfGVnQfqiPPrO7zjN1qMx7BHIyogQsZHhRjLUN5yUHLEgJ3Q/viewform" target="_blank" rel="noopener noreferrer">Open the form in a new tab ↗</a></div></section>
  <section class="contact-bottom"><div><span class="eyebrow">Service window</span><strong>5 AM–6 PM</strong><span>Daily, in-house across DLF Gurugram</span></div><div><span class="eyebrow">Explore first</span><a href="/estimate">Build an instant estimate ↗</a><a href="/locations">Find your community ↗</a></div></section>
</SiteLayout>
<style>
  .contact-hero, .contact-bottom { background-image: linear-gradient(90deg, rgba(14,14,16,.95), rgba(14,14,16,.68)), url('/images/drive/fogging-sanitization.jpeg'); background-position:center; background-size:cover;  max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .contact-hero { display: grid; grid-template-columns: .9fr 1.1fr; gap: 80px; align-items: center; min-height: 650px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 18px 0 24px; color: var(--white); font-size: clamp(53px,6vw,85px); line-height: 1.04; letter-spacing: -.06em; }
  .contact-hero > div:first-child > p { max-width: 480px; margin-bottom: 37px; color: var(--muted); font-size: 16px; }
  .contact-details { display: grid; gap: 15px; }
  .contact-details a { display: block; color: var(--gold-soft); font-size: 17px; font-weight: 600; }
  .contact-details small { display: block; margin-bottom: 2px; color: #8d9cb0; font-size: 9px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .contact-card { padding: 31px; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(226,185,104,.12), rgba(255,255,255,.025)); }
  .contact-card > .eyebrow { display: block; margin-bottom: 25px; }
  .form-embed { width: 100%; overflow: hidden; border: 1px solid rgba(226,185,104,.32); background: #fff; }
  .form-embed iframe { display: block; width: 100%; height: 1480px; border: 0; background: #fff; }
  .form-note { margin: 18px 0 7px; color: #9aa8ba; font-size: 10px; line-height: 1.55; }
  .form-fallback { color: var(--gold-soft); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .contact-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; border-top: 1px solid var(--line); }
  .contact-bottom > div { display: flex; flex-direction: column; gap: 6px; }
  .contact-bottom strong { margin-top: 13px; color: var(--white); font-size: 30px; letter-spacing: -.06em; }
  .contact-bottom > div > span:last-child { color: var(--muted); font-size: 12px; }
  .contact-bottom a { color: var(--gold-soft); font-size: 14px; font-weight: 600; }
  @media (max-width: 850px) { .contact-hero { grid-template-columns: 1fr; gap: 45px; } }
  @media (max-width: 620px) { .contact-hero, .contact-bottom { background-image: linear-gradient(90deg, rgba(14,14,16,.95), rgba(14,14,16,.68)), url('/images/drive/fogging-sanitization.jpeg'); background-position:center; background-size:cover;  padding: 80px 20px; } .contact-hero { min-height: auto; padding-top: 88px; } .contact-card { padding: 22px 20px; } .form-embed iframe { height: 1580px; } .contact-bottom { grid-template-columns: 1fr; } }
.estimate-context{margin-bottom:24px;padding:18px;border:1px solid rgba(59,130,246,.45);border-radius:.5rem;background:rgba(59,130,246,.08)}.estimate-context[hidden]{display:none}.estimate-context .eyebrow{display:block;margin-bottom:10px}.estimate-context strong,.estimate-context small{display:block}.estimate-context strong{color:var(--white);font-size:16px}.estimate-context small{margin-top:5px;color:var(--muted);font-size:12px}.estimate-context p{margin:12px 0 0;color:var(--muted);font-size:12px;line-height:1.45}@media (max-width:620px){.estimate-context{padding:15px}}
</style>
<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector('#estimate-context');
    if (!root) return;
    try {
      const estimate = JSON.parse(sessionStorage.getItem('crestEstimate') || 'null');
      if (!estimate) return;
      const service = document.querySelector('#estimate-context-service');
      const category = document.querySelector('#estimate-context-category');
      const total = document.querySelector('#estimate-context-total');
      if (service) service.textContent = estimate.treatment?.title || 'Selected Crest treatment';
      if (category) category.textContent = `Vehicle category: ${estimate.category || 'To confirm'}`;
      if (total) total.textContent = `Indicative total: ₹${Number(estimate.total || 0).toLocaleString('en-IN')} including GST`;
      root.hidden = false;
    } catch { sessionStorage.removeItem('crestEstimate'); }
  })();
</script>
