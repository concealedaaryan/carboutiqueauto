---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact" description="Contact Crest Automotive to enquire about detailing, packages, coatings, PPF and in-house DLF Gurugram service." currentPath="/contact" pageNumber="07" pageLabel="Start a conversation">
  <section class="contact-hero"><div><span class="eyebrow">07 / Start a conversation</span><h1>Ready for a<br /><em>better finish?</em></h1><p>Tell us your car model, preferred service and community. Our team will get back to confirm availability and the right treatment tier.</p><div class="contact-details"><a href="tel:+919871610952"><small>Ruchir Malhotra</small>+91 98716 10952</a><a href="tel:+919810528263"><small>Ranjeev Kapoor</small>+91 98105 28263</a><a href="https://wa.me/919871610952" target="_blank" rel="noreferrer"><small>Fastest chat</small>WhatsApp ↗</a></div></div><div class="contact-card"><span class="eyebrow">Send an enquiry</span><form id="contact-form"><p class="form-required-note"><span aria-hidden="true">*</span> Required fields</p><div class="form-row"><label>Full name <span aria-hidden="true">*</span><input required type="text" name="name" autocomplete="name" placeholder="Your name" /></label><label>Phone number <span aria-hidden="true">*</span><input required type="tel" name="phone" autocomplete="tel" placeholder="+91" /></label></div><div class="form-row"><label>Vehicle model<input type="text" name="vehicle" autocomplete="off" placeholder="e.g. Mercedes-Benz GLC" /></label><label>Community<select name="community"><option value="">Select community</option><option>The Camellias</option><option>The Crest</option><option>The Magnolias</option></select></label></div><label>What can we help with?<select name="service"><option>Choose a service</option><option>Premium waterless wash & wax</option><option>Interior cleaning (basic)</option><option>Monthly package</option><option>Premium ceramic coating</option><option>Premium graphene coating</option><option>PPF / paint protection</option><option>Other support</option></select></label><label>Message<textarea name="message" rows="4" placeholder="Tell us a little about your car and what you need."></textarea></label><button class="button button-gold" type="submit">Send enquiry <span>↗</span></button><p id="form-status" role="status"></p><small class="form-note"><strong>Demo mode:</strong> this form does not send a message yet. Connect a live endpoint before launch; for immediate help, call or WhatsApp the team above.</small></form></div></section>
  <section class="contact-bottom"><div><span class="eyebrow">Service window</span><strong>5 AM–6 PM</strong><span>Daily, in-house across DLF Gurugram</span></div><div><span class="eyebrow">Explore first</span><a href="/estimate">Build an instant estimate ↗</a><a href="/locations">Find your community ↗</a></div></section>
</SiteLayout>
<style>
  .contact-hero, .contact-bottom { max-width: var(--max); margin: 0 auto; padding: 110px 24px; }
  .contact-hero { display: grid; grid-template-columns: .9fr 1.1fr; gap: 80px; align-items: center; min-height: 650px; }
  .eyebrow { color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 18px 0 24px; color: var(--white); font-size: clamp(53px,6vw,85px); line-height: 1.04; letter-spacing: -.06em; }
  em { color: var(--gold-soft); font-style: normal; }
  .contact-hero > div:first-child > p { max-width: 480px; margin-bottom: 37px; color: var(--muted); font-size: 16px; }
  .contact-details { display: grid; gap: 15px; }
  .contact-details a { display: block; color: var(--gold-soft); font-size: 17px; font-weight: 600; }
  .contact-details small { display: block; margin-bottom: 2px; color: #8d9cb0; font-size: 9px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .contact-card { padding: 31px; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(226,185,104,.12), rgba(255,255,255,.025)); }
  .contact-card .eyebrow { display: block; margin-bottom: 25px; }
  form { display: grid; gap: 18px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-required-note { margin: -8px 0 0; color: #8998ad; font-size: 10px; }
  .form-required-note span, label > span { color: var(--gold-soft); }
  label { display: block; color: #aab7c8; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  input, select, textarea { width: 100%; margin-top: 8px; padding: 13px 0; border: 0; border-bottom: 1px solid #52647b; border-radius: 0; outline: 0; color: var(--white); background: transparent; font-size: 13px; font-weight: 400; letter-spacing: 0; text-transform: none; }
  option { color: var(--ink); }
  input:focus, select:focus, textarea:focus { border-bottom-color: var(--gold); }
  input:user-invalid { border-bottom-color: #ef9a8d; }
  input::placeholder, textarea::placeholder { color: #7f90a5; opacity: 1; }
  textarea { resize: vertical; }
  .contact-card button { margin-top: 8px; }
  #form-status { min-height: 20px; margin: 0; color: var(--gold-soft); font-size: 12px; }
  .form-note { display: block; color: #9aa8ba; font-size: 10px; line-height: 1.55; }
  .form-note strong { color: var(--gold-soft); }
  .contact-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; border-top: 1px solid var(--line); }
  .contact-bottom > div { display: flex; flex-direction: column; gap: 6px; }
  .contact-bottom strong { margin-top: 13px; color: var(--white); font-size: 30px; letter-spacing: -.06em; }
  .contact-bottom > div > span:last-child { color: var(--muted); font-size: 12px; }
  .contact-bottom a { color: var(--gold-soft); font-size: 14px; font-weight: 600; }
  @media (max-width: 850px) { .contact-hero { grid-template-columns: 1fr; gap: 45px; } }
  @media (max-width: 620px) { .contact-hero, .contact-bottom { padding: 80px 20px; } .contact-hero { min-height: auto; padding-top: 88px; } .contact-card { padding: 22px 20px; } .form-row { grid-template-columns: 1fr; gap: 18px; } .contact-bottom { grid-template-columns: 1fr; } }
</style>
<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('#form-status');
  const params = new URLSearchParams(window.location.search);
  const packageName = params.get('package');
  const communityName = params.get('community');
  if (packageName && form) { const service = form.querySelector('[name="service"]'); const message = form.querySelector('[name="message"]'); if (service) service.value = 'Monthly package'; if (message) message.value = `I am interested in the ${packageName} monthly package.`; }
  if (communityName && form) { const community = form.querySelector('[name="community"]'); if (community && [...community.options].some((option) => option.value === communityName)) community.value = communityName; }
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (status) status.textContent = 'Thanks — your enquiry is captured in this preview. In production, it will be sent to the Crest team. For immediate help, call or WhatsApp us above.'; form.reset(); });
  const estimate = sessionStorage.getItem('crestEstimate');
  if (estimate && form) { try { const data = JSON.parse(estimate); const service = form.querySelector('[name="service"]'); const message = form.querySelector('[name="message"]'); if (service) { const matching = [...service.options].find((option) => option.textContent.toLowerCase().includes(data.treatment.title.toLowerCase())); if (matching) service.value = matching.value; } if (message) message.value = `Estimate request: ${data.treatment.title} · ${data.category} · ₹${data.total.toLocaleString('en-IN')} including GST${data.labels?.length ? ` · ${data.labels.join(', ')}` : ''}.`; sessionStorage.removeItem('crestEstimate'); } catch (error) { console.warn('Could not read estimate handoff', error); } }
  })();
</script>
