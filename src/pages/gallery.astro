---
import SiteLayout from '../layouts/SiteLayout.astro';

const photos = [
  { src: '/images/gallery/rover-front-detail.jpeg', label: 'Studio arrival', category: 'detail', caption: 'A close view of the Rover finish under Crest studio lighting.' },
  { src: '/images/gallery/rover-studio-front.jpeg', label: 'Light tunnel', category: 'studio', caption: 'Controlled light, clean reflections and a careful final inspection.' },
  { src: '/images/gallery/rover-studio-angle.jpeg', label: 'Paint clarity', category: 'detail', caption: 'The studio angle that makes the surface story visible.' },
  { src: '/images/gallery/rover-studio-side.jpeg', label: 'Side profile', category: 'studio', caption: 'A full side view after the finishing process.' },
  { src: '/images/gallery/rover-road-side.jpeg', label: 'Ready to leave', category: 'road', caption: 'The vehicle back in daylight after its Crest visit.' },
  { src: '/images/gallery/rover-road-front.jpeg', label: 'Front finish', category: 'road', caption: 'A front three-quarter view with the finish catching the sun.' },
  { src: '/images/gallery/rover-studio-front-wide.jpeg', label: 'Final check', category: 'studio', caption: 'A wider studio frame from the final handover sequence.' },
  { src: '/images/gallery/rover-road-rear.jpeg', label: 'Rear detail', category: 'road', caption: 'Road-ready from the rear, with the finish still in focus.' },
  { src: '/images/gallery/rover-road-profile.jpeg', label: 'On the road', category: 'road', caption: 'A clean profile in natural daylight.' },
  { src: '/images/gallery/rover-road-three-quarter.jpeg', label: 'Three-quarter view', category: 'detail', caption: 'The shape, stance and surface in one frame.' },
  { src: '/images/gallery/rover-road-front-light.jpeg', label: 'Front light', category: 'road', caption: 'Natural light reveals the work without a studio wash.' },
  { src: '/images/gallery/rover-road-front-full.jpeg', label: 'Handover moment', category: 'road', caption: 'The finished car, ready for its next drive.' },
  { src: '/images/gallery/rover-road-front-close.jpeg', label: 'Final frame', category: 'detail', caption: 'A close-out frame from the supplied Crest visit.' },
];
---

<SiteLayout title="Gallery | Crest Automotive Care" description="A visual gallery of Crest Automotive Care studio work, supplied vehicle photography and detailing moments, with a link to Crest's Instagram reels." currentPath="/gallery" pageLabel="Crest gallery">
  <section class="gallery-hero">
    <div class="gallery-hero-copy">
      <span class="eyebrow">Crest Automotive Care · visual record</span>
      <h1>Care you can<br /><em>see in the finish.</em></h1>
      <p>A visual record of studio light, careful preparation and the cars that leave Crest looking ready for the road.</p>
      <div class="gallery-actions"><a class="button button-gold" href="#gallery-grid">View the gallery <span>↘</span></a><a class="text-action" href="https://www.instagram.com/crest_automotive/reels/" target="_blank" rel="noopener noreferrer">Watch Instagram reels <span>↗</span></a></div>
    </div>
    <div class="gallery-hero-media">
      <video controls playsinline preload="metadata" poster="/images/gallery/crest-detailing-session-poster.jpg" aria-label="Crest Automotive Care detailing session video">
        <source src="/images/gallery/crest-detailing-session.mp4" type="video/mp4" />
        Your browser does not support the video element.
      </video>
      <div class="media-caption"><button class="media-open" type="button" data-lightbox-video="/images/gallery/crest-detailing-session.mp4" data-lightbox-poster="/images/gallery/crest-detailing-session-poster.jpg" data-lightbox-title="Supplied Crest detailing session">Open full-screen viewer</button></div>
    </div>
  </section>

  <section class="gallery-intro">
    <div><span class="eyebrow">From the supplied Crest archive</span><h2>Studio light.<br /><em>Road-ready finish.</em></h2></div>

  </section>

  <section id="gallery-grid" class="gallery-gallery-section" aria-label="Crest Automotive Care photo gallery">
    <div class="gallery-toolbar">
      <div><span class="eyebrow">Browse the archive</span><p class="gallery-count" data-gallery-count>{photos.length} photographs</p></div>
      <div class="gallery-filters" role="tablist" aria-label="Filter gallery photographs">
        <button type="button" role="tab" class="gallery-filter is-active" data-gallery-filter="all" aria-selected="true" aria-controls="gallery-grid">All work <span>13</span></button>
        <button type="button" role="tab" class="gallery-filter" data-gallery-filter="studio" aria-selected="false" aria-controls="gallery-grid">Studio <span>3</span></button>
        <button type="button" role="tab" class="gallery-filter" data-gallery-filter="road" aria-selected="false" aria-controls="gallery-grid">On the road <span>5</span></button>
        <button type="button" role="tab" class="gallery-filter" data-gallery-filter="detail" aria-selected="false" aria-controls="gallery-grid">Details <span>5</span></button>
      </div>
    </div>
    <div class="gallery-grid">
      {photos.map((photo, index) => <figure class:list={[`gallery-card gallery-card-${(index % 6) + 1}`, index === 0 ? 'gallery-card-featured' : '']} data-gallery-item={photo.category}>
        <button class="gallery-trigger" type="button" data-lightbox-image={photo.src} data-lightbox-title={photo.label} data-lightbox-caption={photo.caption} aria-label={`Open ${photo.label} in full-screen viewer`}><span>Open image</span></button>
        <img src={photo.src} alt={photo.caption} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
        <figcaption><span>{photo.label}</span><strong>{photo.caption}</strong></figcaption>
      </figure>)}
    </div>
  </section>

  <div class="gallery-lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-dialog" role="document">
      <div class="lightbox-toolbar"><span id="lightbox-title" data-lightbox-title-output>Gallery viewer</span><button class="lightbox-close" type="button" data-lightbox-close aria-label="Close gallery viewer">×</button></div>
      <div class="lightbox-stage" data-lightbox-stage></div>
      <div class="lightbox-caption" data-lightbox-caption-output></div>
      <div class="lightbox-navigation"><button type="button" data-lightbox-prev aria-label="Previous gallery item">← Previous</button><span data-lightbox-position>1 / 1</span><button type="button" data-lightbox-next aria-label="Next gallery item">Next →</button></div>
    </div>
  </div>

  <section class="instagram-gallery">
    <div class="instagram-mark" aria-hidden="true">◎</div>
    <div>
      <span class="eyebrow">Crest on Instagram</span>
      <h2>More work in motion.<br /><em>Follow the reels.</em></h2>
      <p>The latest Crest Automotive Care reels live on the official Instagram profile. Open the public reels feed to see the newest detailing, protection and handover moments.</p>
      <a class="button button-gold" href="https://www.instagram.com/crest_automotive/reels/" target="_blank" rel="noopener noreferrer">Open Crest reels <span>↗</span></a>
    </div>
    <div class="instagram-meta"><strong>@crest_automotive</strong><span>Official Crest Automotive Solutions LLP profile</span><a href="https://www.instagram.com/crest_automotive/" target="_blank" rel="noopener noreferrer">View profile ↗</a></div>
  </section>
</SiteLayout>

<style>
  .gallery-hero, .gallery-intro, .gallery-grid, .instagram-gallery { max-width: var(--max); margin: 0 auto; padding-inline: 24px; }
  .gallery-hero { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 7vw, 100px); align-items: center; min-height: 700px; padding-top: 150px; padding-bottom: 105px; }
  .gallery-hero::before { content: ''; position: absolute; z-index: -1; inset: 84px 0 auto; height: 670px; background: radial-gradient(circle at 78% 40%, rgba(59,130,246,.18), transparent 32%), linear-gradient(118deg, #131315 18%, #0b2038 100%); }
  .gallery-hero h1 { margin: 20px 0 24px; font-size: clamp(48px, 6vw, 84px); line-height: .98; }
  .gallery-hero h1 em, .gallery-intro h2 em, .instagram-gallery h2 em { color: var(--gold-soft); font-style: normal; }
  .gallery-hero-copy > p { max-width: 510px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .gallery-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 32px; }
  .gallery-hero-media { position: relative; overflow: hidden; border: 1px solid rgba(59,130,246,.36); background: #0b2038; box-shadow: 0 24px 60px rgba(0,0,0,.28); }
  .gallery-hero-media video { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #0b2038; }
  .media-caption { display: block; padding: 13px 17px; color: #d8e5ee; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .gallery-intro { display: grid; grid-template-columns: 1fr minmax(280px, 390px); gap: 80px; align-items: end; padding-top: 110px; padding-bottom: 55px; border-top: 1px solid var(--line); }
  .gallery-intro h2, .instagram-gallery h2 { margin: 14px 0 0; font-size: clamp(36px, 4.5vw, 62px); line-height: 1.02; }
  .gallery-intro > p, .instagram-gallery p { color: var(--muted); font-size: 15px; line-height: 1.7; }
  .gallery-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; padding-bottom: 115px; }
  .gallery-card { position: relative; min-width: 0; min-height: 300px; margin: 0; overflow: hidden; border: 1px solid rgba(59,130,246,.24); background: #0d2440; }
  .gallery-card img { display: block; width: 100%; height: 100%; min-height: 300px; object-fit: cover; transition: transform .6s var(--ease); }
  .gallery-card figcaption { position: absolute; right: 0; bottom: 0; left: 0; display: grid; gap: 7px; padding: 54px 20px 19px; background: linear-gradient(180deg, transparent, rgba(8,24,39,.94)); }
  .gallery-card figcaption span { color: #f0b275; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .gallery-card figcaption strong { color: #fff; font-size: 14px; font-weight: 500; line-height: 1.35; }
  .gallery-card:hover img { transform: scale(1.035); }
  .gallery-card-1, .gallery-card-5, .gallery-card-9 { grid-column: span 5; }
  .gallery-card-2, .gallery-card-3, .gallery-card-6, .gallery-card-7, .gallery-card-10, .gallery-card-11 { grid-column: span 3.5; }
  .gallery-card-4, .gallery-card-8, .gallery-card-12, .gallery-card-13 { grid-column: span 4; }
  .gallery-card-featured { min-height: 510px; }
  .gallery-card-featured img { min-height: 510px; }
  .instagram-gallery { display: grid; grid-template-columns: 90px 1fr minmax(190px, 250px); gap: 34px; align-items: center; max-width: none; padding-top: 95px; padding-bottom: 95px; background: linear-gradient(120deg, #0c2d4a, #123d66); }
  .instagram-mark { display: grid; place-items: center; width: 68px; height: 68px; border: 1px solid rgba(240,178,117,.7); border-radius: 22px; color: #f0b275; font-size: 46px; line-height: 1; }
  .instagram-gallery h2 { color: #fff; }
  .instagram-gallery p { max-width: 650px; color: #d8e5ee; }
  .instagram-meta { display: grid; gap: 7px; padding-left: 24px; border-left: 1px solid rgba(255,255,255,.24); }
  .instagram-meta strong { color: #fff; font-size: 17px; }
  .instagram-meta span, .instagram-meta a { color: #d8e5ee; font-size: 12px; line-height: 1.5; }
  .instagram-meta a { color: #f0b275; font-weight: 700; }
  @media (max-width: 900px) { .gallery-hero { grid-template-columns: 1fr; min-height: auto; padding-top: 120px; } .gallery-hero-media { max-width: 720px; } .gallery-intro { grid-template-columns: 1fr; gap: 25px; } .instagram-gallery { grid-template-columns: 68px 1fr; } .instagram-meta { grid-column: 2; } }
  @media (max-width: 620px) { .gallery-hero, .gallery-intro, .gallery-grid { padding-inline: 20px; } .gallery-hero { padding-top: 110px; padding-bottom: 78px; } .gallery-hero h1 { font-size: clamp(44px, 13vw, 62px); } .gallery-hero-copy > p { font-size: 16px; } .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding-bottom: 80px; } .gallery-card, .gallery-card-featured { grid-column: span 1; min-height: 270px; } .gallery-card-featured { grid-column: span 2; } .gallery-card img, .gallery-card-featured img { min-height: 270px; } .gallery-card-featured img { min-height: 400px; } .gallery-card figcaption { padding: 50px 13px 13px; } .gallery-card figcaption strong { font-size: 12px; } .instagram-gallery { grid-template-columns: 1fr; gap: 24px; padding: 72px 20px; } .instagram-mark { width: 56px; height: 56px; font-size: 38px; } .instagram-meta { grid-column: auto; padding-top: 22px; padding-left: 0; border-top: 1px solid rgba(255,255,255,.24); border-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .gallery-card img { transition: none; } .gallery-card:hover img { transform: none; } }
</style>

<style is:global>
  body main .gallery-hero .eyebrow { color: #f0b275 !important; }
  body main .gallery-hero h1 { color: #fff !important; }
  body main .gallery-hero h1 em { color: #f0b275 !important; -webkit-text-fill-color: #f0b275 !important; }
  body main .gallery-hero-copy > p { color: #e5edf5 !important; }
  body main .gallery-hero .text-action { color: #f0b275 !important; }
  body main .gallery-hero .text-action:hover,
  body main .gallery-hero .text-action:focus-visible { color: #fff !important; }
</style>

<style>
  .gallery-gallery-section { max-width: var(--max); margin: 0 auto; padding: 0 24px 115px; }
  .gallery-toolbar { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 22px; padding-top: 12px; border-top: 1px solid var(--line); }
  .gallery-count { margin: 10px 0 0; color: var(--muted); font-size: 13px; }
  .gallery-filters { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .gallery-filter, .media-open, .lightbox-navigation button { border: 1px solid rgba(59,130,246,.34); border-radius: 999px; color: #d8e5ee; background: rgba(8,24,39,.86); cursor: pointer; font-size: 11px; font-weight: 700; letter-spacing: .04em; transition: border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease; }
  .gallery-filter { padding: 10px 15px; }
  .gallery-filter:hover, .gallery-filter:focus-visible, .gallery-filter.is-active { border-color: #f0b275; color: #081827; background: #f0b275; }
  .gallery-filter:focus-visible, .media-open:focus-visible, .lightbox-navigation button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .gallery-card[hidden] { display: none; }
  .gallery-trigger { position: absolute; z-index: 2; inset: 0; width: 100%; height: 100%; border: 0; padding: 0; color: transparent; background: transparent; cursor: zoom-in; }
  .gallery-trigger span { position: absolute; top: 16px; right: 16px; padding: 8px 10px; border: 1px solid rgba(255,255,255,.28); border-radius: 999px; color: #fff; background: rgba(8,24,39,.72); font-size: 10px; font-weight: 700; letter-spacing: .05em; opacity: 0; transform: translateY(-4px); transition: opacity .2s ease, transform .2s ease; }
  .gallery-card:hover .gallery-trigger span, .gallery-trigger:focus-visible span { opacity: 1; transform: none; }
  .gallery-trigger:focus-visible { outline: 2px solid #f0b275; outline-offset: -5px; }
  .media-caption { display: flex; justify-content: space-between; align-items: center; gap: 15px; }
  .media-open { flex: 0 0 auto; padding: 8px 12px; color: #f0b275; background: rgba(8,24,39,.5); }
  .media-open:hover, .media-open:focus-visible { color: #081827; background: #f0b275; }
  .gallery-lightbox { position: fixed; z-index: 100; inset: 0; display: grid; place-items: center; padding: 22px; opacity: 0; pointer-events: none; visibility: hidden; transition: opacity .2s ease, visibility .2s ease; }
  .gallery-lightbox.is-open { opacity: 1; pointer-events: auto; visibility: visible; }
  .lightbox-backdrop { position: absolute; inset: 0; background: rgba(3,10,17,.9); backdrop-filter: blur(10px); }
  .lightbox-dialog { position: relative; z-index: 1; display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; width: min(100%, 1120px); max-height: calc(100vh - 44px); overflow: hidden; border: 1px solid rgba(240,178,117,.35); background: #081827; box-shadow: 0 30px 90px rgba(0,0,0,.5); }
  .lightbox-toolbar, .lightbox-navigation { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 14px 18px; color: #e5edf5; font-size: 12px; }
  .lightbox-toolbar { border-bottom: 1px solid rgba(255,255,255,.13); color: #f0b275; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .lightbox-close { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(255,255,255,.25); border-radius: 50%; color: #fff; background: transparent; cursor: pointer; font-size: 25px; line-height: 1; }
  .lightbox-close:hover, .lightbox-close:focus-visible { border-color: #f0b275; color: #081827; background: #f0b275; }
  .lightbox-stage { display: grid; place-items: center; min-height: 240px; overflow: auto; padding: 18px; background: #030a11; }
  .lightbox-stage img, .lightbox-stage video { display: block; max-width: 100%; max-height: min(68vh, 760px); object-fit: contain; }
  .lightbox-stage video { width: min(100%, 980px); }
  .lightbox-caption { padding: 0 18px 14px; color: #d8e5ee; font-size: 13px; line-height: 1.5; }
  .lightbox-navigation { border-top: 1px solid rgba(255,255,255,.13); }
  .lightbox-navigation button { padding: 8px 12px; }
  .lightbox-navigation button:disabled { opacity: .35; cursor: not-allowed; }
  @media (max-width: 720px) { .gallery-gallery-section { padding-inline: 20px; } .gallery-toolbar { display: block; } .gallery-filters { justify-content: flex-start; margin-top: 20px; } .gallery-lightbox { padding: 10px; } .lightbox-dialog { max-height: calc(100vh - 20px); } .lightbox-toolbar, .lightbox-navigation { padding: 12px; } .lightbox-stage { padding: 10px; } .lightbox-stage img, .lightbox-stage video { max-height: 60vh; } .media-caption { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .gallery-filter, .media-open, .lightbox-navigation button, .gallery-lightbox, .gallery-trigger span { transition: none; } }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector('[data-lightbox]');
    const stage = root?.querySelector('[data-lightbox-stage]');
    const titleOutput = root?.querySelector('[data-lightbox-title-output]');
    const captionOutput = root?.querySelector('[data-lightbox-caption-output]');
    const positionOutput = root?.querySelector('[data-lightbox-position]');
    const prevButton = root?.querySelector('[data-lightbox-prev]');
    const nextButton = root?.querySelector('[data-lightbox-next]');
    const closeButtons = root ? [...root.querySelectorAll('[data-lightbox-close]')] : [];
    const filterButtons = [...document.querySelectorAll('[data-gallery-filter]')];
    const countOutput = document.querySelector('[data-gallery-count]');
    const galleryItems = () => [...document.querySelectorAll('[data-gallery-item]:not([hidden]) .gallery-trigger')];
    if (!root || !stage || !titleOutput || !captionOutput || !positionOutput || !prevButton || !nextButton) return;
    let activeIndex = 0;
    let activeType = 'image';
    let lastFocused = null;

    const setFilter = (filter) => {
      document.querySelectorAll('[data-gallery-item]').forEach((item) => { item.hidden = filter !== 'all' && item.dataset.galleryItem !== filter; });
      filterButtons.forEach((button) => { const isActive = button.dataset.galleryFilter === filter; button.classList.toggle('is-active', isActive); button.setAttribute('aria-selected', String(isActive)); });
      const count = galleryItems().length;
      if (countOutput) countOutput.textContent = `${count} photograph${count === 1 ? '' : 's'}`;
      if (activeType === 'image' && root.classList.contains('is-open')) { activeIndex = Math.min(activeIndex, Math.max(0, count - 1)); renderImage(); }
    };

    const renderImage = () => {
      const items = galleryItems();
      if (!items.length) return;
      const trigger = items[activeIndex];
      stage.replaceChildren();
      const image = document.createElement('img');
      image.src = trigger.dataset.lightboxImage || '';
      image.alt = trigger.dataset.lightboxTitle || 'Crest Automotive Care gallery image';
      stage.append(image);
      requestAnimationFrame(() => image.classList.add('is-ready'));
      activeType = 'image';
      titleOutput.textContent = trigger.dataset.lightboxTitle || 'Gallery viewer';
      captionOutput.textContent = trigger.dataset.lightboxCaption || '';
      positionOutput.textContent = `${activeIndex + 1} / ${items.length}`;
      prevButton.disabled = items.length < 2;
      nextButton.disabled = items.length < 2;
    };

    const renderVideo = (button) => {
      stage.replaceChildren();
      const video = document.createElement('video');
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.poster = button.dataset.lightboxPoster || '';
      const source = document.createElement('source');
      source.src = button.dataset.lightboxVideo || '';
      source.type = 'video/mp4';
      video.append(source);
      stage.append(video);
      requestAnimationFrame(() => video.classList.add('is-ready'));
      activeType = 'video';
      titleOutput.textContent = button.dataset.lightboxTitle || 'Crest detailing session';
      captionOutput.textContent = 'Supplied Crest detailing session · video';
      positionOutput.textContent = 'Video';
      prevButton.disabled = true;
      nextButton.disabled = true;
    };

    const open = (button) => {
      lastFocused = document.activeElement;
      root.classList.add('is-open');
      root.setAttribute('aria-hidden', 'false');
      document.body.classList.add('gallery-lightbox-open');
      if (button.dataset.lightboxVideo) renderVideo(button);
      else { activeIndex = galleryItems().indexOf(button); renderImage(); }
      root.querySelector('.lightbox-close')?.focus();
    };
    const close = () => { root.classList.remove('is-open'); root.setAttribute('aria-hidden', 'true'); document.body.classList.remove('gallery-lightbox-open'); stage.replaceChildren(); lastFocused?.focus?.(); };
    const step = (amount) => { const items = galleryItems(); if (activeType !== 'image' || items.length < 2) return; activeIndex = (activeIndex + amount + items.length) % items.length; renderImage(); };

    filterButtons.forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.galleryFilter || 'all')));
    document.querySelectorAll('[data-lightbox-image], [data-lightbox-video]').forEach((button) => button.addEventListener('click', () => open(button)));
    closeButtons.forEach((button) => button.addEventListener('click', close));
    prevButton.addEventListener('click', () => step(-1));
    nextButton.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (event) => { if (!root.classList.contains('is-open')) return; if (event.key === 'Escape') close(); if (event.key === 'ArrowLeft') step(-1); if (event.key === 'ArrowRight') step(1); });
    setFilter('all');
  })();
</script>

<style is:global>
  body.gallery-lightbox-open { overflow: hidden; }
</style>

<style is:global>
  /* Editorial gallery correction: equal columns, full portrait frames, no fractional grid spans. */
  body main .gallery-gallery-section .gallery-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    align-items: start !important;
    gap: 18px !important;
  }
  body main .gallery-gallery-section .gallery-card,
  body main .gallery-gallery-section .gallery-card-featured {
    grid-column: auto !important;
    min-height: 0 !important;
    height: auto !important;
    aspect-ratio: 9 / 14 !important;
  }
  body main .gallery-gallery-section .gallery-card img,
  body main .gallery-gallery-section .gallery-card-featured img {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    object-fit: cover !important;
  }
  body main .gallery-hero-media {
    width: min(100%, 430px) !important;
    justify-self: end !important;
  }
  body main .gallery-hero-media video {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    background: #030a11 !important;
  }
  @media (max-width: 900px) {
    body main .gallery-hero-media { justify-self: start !important; }
  }
