      if (thread && !reducedMotion) thread.style.transform = `translateY(${(window.innerHeight - thread.offsetHeight) * pageProgress}px)`;
      const focusLine = window.innerHeight * .46;
      let activeIndex = 0;
      let nearestDistance = Number.POSITIVE_INFINITY;
      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        const height = Math.max(1, rect.height);
        const center = rect.top + height / 2;
        const focus = clamp(1 - Math.abs(center - focusLine) / (window.innerHeight * .7));
        const enter = clamp((window.innerHeight - rect.top) / (window.innerHeight + Math.min(height, window.innerHeight) * .48));
        const exit = clamp((focusLine - rect.bottom) / Math.max(180, height * .36));
        const distance = Math.abs(center - focusLine);
        section.style.setProperty('--section-focus', focus.toFixed(4));
        section.style.setProperty('--section-enter', enter.toFixed(4));
        section.style.setProperty('--section-exit', exit.toFixed(4));
        section.style.setProperty('--section-progress', clamp((focusLine - rect.top) / (height + window.innerHeight * .28)).toFixed(4));
        section.classList.toggle('is-scroll-entering', enter > .12 && rect.top > 0);
        section.classList.toggle('is-scroll-exiting', exit > .2 && rect.bottom > 0);
        if (distance < nearestDistance) { nearestDistance = distance; activeIndex = index; }
      });
      sections.forEach((section, index) => section.classList.toggle('is-scroll-active', index === activeIndex));
    };
    const requestSync = () => { if (!frame) frame = window.requestAnimationFrame(sync); };
    sync();
    if (!reducedMotion) {
      window.addEventListener('scroll', requestSync, { passive: true, signal: controller.signal });
      window.addEventListener('resize', requestSync, { passive: true, signal: controller.signal });
    }
    document.addEventListener('astro:page-load', requestSync, { signal: controller.signal });
    window.__crestConnectedScrollCleanup = () => {
      controller.abort();
      window.cancelAnimationFrame(frame);
      body.classList.remove('connected-scroll');
      sections.forEach((section) => { section.classList.remove('connected-section', 'is-scroll-active', 'is-scroll-entering', 'is-scroll-exiting'); section.style.removeProperty('--section-focus'); section.style.removeProperty('--section-enter'); section.style.removeProperty('--section-exit'); section.style.removeProperty('--section-progress'); section.removeAttribute('data-connected-index'); });
      root.style.removeProperty('--body-scroll-progress');
      root.style.removeProperty('--body-light-x');
      root.style.removeProperty('--body-light-y');
      root.style.removeProperty('--body-scroll-direction');
    };
  })();
</script>

