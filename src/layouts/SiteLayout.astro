    const links = [...rail.querySelectorAll('[data-station-link]')];
    const current = rail.querySelector('[data-station-current]');
    const sections = [...document.querySelectorAll('main > section[data-station]')];
    const byStation = new Map(sections.map((section) => [section.dataset.station, section]));
