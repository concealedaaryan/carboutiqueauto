<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
    window.__crestStudioRailVisibilityCleanup?.();
    const controller = new AbortController();
    const rail = document.querySelector('.studio-rail');
    if (!rail) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;
    let idleTimer = 0;
    let collapseTimer = 0;
    let lastY = window.scrollY;
    const showBriefly = () => {
      rail.classList.remove('is-rail-collapsed');
      window.clearTimeout(collapseTimer);
      collapseTimer = window.setTimeout(() => rail.classList.add('is-rail-collapsed'), 2100);
    };
    const onScroll = () => {
      rail.classList.add('is-rail-collapsed');
      window.clearTimeout(idleTimer);
      window.clearTimeout(collapseTimer);
      idleTimer = window.setTimeout(showBriefly, 420);
      lastY = window.scrollY;
    };
    const onPointerEnter = () => { rail.classList.remove('is-rail-collapsed'); window.clearTimeout(collapseTimer); };
    const onPointerLeave = () => { if (window.scrollY > 120) collapseTimer = window.setTimeout(() => rail.classList.add('is-rail-collapsed'), 900); };
    const onFocus = () => { rail.classList.remove('is-rail-collapsed'); window.clearTimeout(collapseTimer); };
    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    rail.addEventListener('pointerenter', onPointerEnter, { signal: controller.signal });
    rail.addEventListener('pointerleave', onPointerLeave, { signal: controller.signal });
    rail.addEventListener('focusin', onFocus, { signal: controller.signal });
    rail.addEventListener('click', showBriefly, { signal: controller.signal });
    if (window.scrollY > 120) rail.classList.add('is-rail-collapsed');
    window.__crestStudioRailVisibilityCleanup = () => { controller.abort(); window.clearTimeout(idleTimer); window.clearTimeout(collapseTimer); rail.classList.remove('is-rail-collapsed'); };
  })();
</script>

