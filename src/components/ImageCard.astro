---
interface Props { src: string; alt: string; eyebrow?: string; title?: string; caption?: string; href?: string; }
const { src, alt, eyebrow = '', title = '', caption = '', href = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class={`image-card ${href ? 'is-link' : ''}`} href={href || undefined}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <div class="image-wash"></div>
  {(eyebrow || title || caption) && <div class="image-copy">{eyebrow && <span>{eyebrow}</span>}{title && <strong>{title}</strong>}{caption && <small>{caption}</small>}</div>}
</Tag>
<style>
  .image-card { position:relative; display:block; aspect-ratio:4 / 3; min-height:0; overflow:hidden; border:1px solid var(--line); background:var(--panel); }
  .image-card img { display:block; width:100%; height:100%; min-height:0; object-fit:cover; object-position:center; transition:transform .8s var(--ease),filter .45s ease; }
  .image-wash { position:absolute; inset:0; background:linear-gradient(180deg,transparent 35%,rgba(19,19,21,.9) 100%); }
  .image-copy { position:absolute; right:22px; bottom:20px; left:22px; display:grid; gap:5px; }
  .image-copy span { color:var(--gold); font-size:9px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
  .image-copy strong { color:var(--white); font-size:20px; letter-spacing:-.03em; }
  .image-copy small { color:var(--white); font-size:11px; line-height:1.4; }
  .image-card.is-link:hover img, .image-card.is-link:focus-visible img { transform:scale(1.045); filter:saturate(1.08); }
  .image-card.is-link:focus-visible { outline:2px solid var(--gold-soft); outline-offset:4px; }
</style>
