---
interface Slide {
  src: string;
  eyebrow: string;
  caption: string;
  description: string;
}

interface Props {
  slides: Slide[];
  label?: string;
}

const { slides, label = 'Crest Automotive hero images' }: Props = Astro.props;
---
<div class="hero-carousel" data-hero-carousel aria-label={label}>
  <div class="hero-carousel-track">
    {slides.map((slide, index) => (
      <div
        class:list={["hero-carousel-slide", index === 0 && "is-active"]}
        style={`--hero-image: url("${slide.src}");`}
        data-carousel-slide
        data-index={index}
        role="img"
        aria-roledescription="slide"
        aria-label={`${slide.eyebrow}. ${slide.description}`}
        aria-hidden={index === 0 ? undefined : 'true'}
      >
        <div class="hero-carousel-overlay" aria-hidden="true"></div>
        <div class="hero-carousel-caption">
          <span>{slide.eyebrow}</span>
          <small>{slide.caption}</small>
        </div>
      </div>
    ))}
  </div>
  <div class="hero-carousel-controls">
    <button type="button" class="carousel-control" data-carousel-prev aria-label="Previous hero image">←</button>
    <div class="carousel-dots" role="tablist" aria-label="Choose hero image">
      {slides.map((_, index) => (
        <button type="button" class:list={["carousel-dot", index === 0 && "is-active"]} data-carousel-dot data-index={index} role="tab" aria-label={`Show hero image ${index + 1}`} aria-selected={index === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <button type="button" class="carousel-control" data-carousel-next aria-label="Next hero image">→</button>
  </div>
</div>

<style>
  .hero-carousel{position:relative;min-height:540px;overflow:hidden;border:1px solid rgba(190,198,224,.32);border-radius:.5rem;background:#1b1b1d;isolation:isolate}.hero-carousel-track,.hero-carousel-slide{position:absolute;inset:0}.hero-carousel-slide{background-image:var(--hero-image);background-position:center;background-size:cover;opacity:0;transform:scale(1.015);transition:opacity .55s cubic-bezier(.23,1,.32,1),transform 1.2s cubic-bezier(.23,1,.32,1)}.hero-carousel-slide.is-active{opacity:1;transform:scale(1)}.hero-carousel-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,14,16,.04) 18%,rgba(14,14,16,.18) 45%,rgba(14,14,16,.94) 100%),linear-gradient(90deg,rgba(14,14,16,.18),transparent 60%)}.hero-carousel-caption{position:absolute;right:26px;bottom:24px;left:26px;z-index:1;display:flex;align-items:end;justify-content:space-between;gap:20px}.hero-carousel-caption span{color:#60a5fa;font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.hero-carousel-caption small{color:#e4e2e4;font-size:12px}.hero-carousel-controls{position:absolute;right:22px;bottom:65px;z-index:2;display:flex;align-items:center;gap:12px}.carousel-control{display:grid;place-items:center;width:34px;height:34px;padding:0;border:1px solid rgba(228,226,228,.48);border-radius:.375rem;color:#fff;background:rgba(19,19,21,.58);backdrop-filter:blur(12px);cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease}.carousel-control:hover,.carousel-control:focus-visible{border-color:#60a5fa;background:rgba(59,130,246,.7)}.carousel-control:active{transform:scale(.97)}.carousel-dots{display:flex;align-items:center;gap:6px}.carousel-dot{width:20px;height:2px;padding:0;border:0;background:rgba(228,226,228,.45);cursor:pointer;transition:width .2s ease,background .2s ease}.carousel-dot.is-active{width:32px;background:#60a5fa}.carousel-dot:focus-visible{outline:2px solid #60a5fa;outline-offset:5px}@media(max-width:620px){.hero-carousel{min-height:320px}.hero-carousel-caption{right:18px;bottom:18px;left:18px;display:grid;gap:5px}.hero-carousel-caption small{font-size:11px}.hero-carousel-controls{right:16px;bottom:63px}.carousel-control{width:32px;height:32px}}@media(prefers-reduced-motion:reduce){.hero-carousel-slide{transition:none}}
</style>

<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
    window.__crestHeroCarouselCleanup?.();
    const root = document.querySelector('[data-hero-carousel]');
    if (!root) return;
    const slides = [...root.querySelectorAll('[data-carousel-slide]')];
    const dots = [...root.querySelectorAll('[data-carousel-dot]')];
    const prev = root.querySelector('[data-carousel-prev]');
    const next = root.querySelector('[data-carousel-next]');
    if (slides.length < 2) return;
    let current = 0;
    let timer;
    let paused = false;
    const show = (index) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', String(active));
      });
    };
    const reset = () => { window.clearInterval(timer); timer = window.setInterval(() => { if (!paused) show(current + 1); }, 6500); };
    const goPrev = () => { show(current - 1); reset(); };
    const goNext = () => { show(current + 1); reset(); };
    prev?.addEventListener('click', goPrev);
    next?.addEventListener('click', goNext);
    dots.forEach((dot) => dot.addEventListener('click', () => { show(Number(dot.dataset.index)); reset(); }));
    root.addEventListener('mouseenter', () => { paused = true; });
    root.addEventListener('mouseleave', () => { paused = false; });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });
    show(0);
    reset();
    window.__crestHeroCarouselCleanup = () => { window.clearInterval(timer); };
  })();
</script>
