<button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top><span aria-hidden="true">↑</span></button>
<style>
  .back-to-top { position: fixed; z-index: 55; right: 22px; bottom: 88px; display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 1px solid rgba(59,130,246,.5); border-radius: 50%; color: var(--gold-soft); background: linear-gradient(145deg, rgba(59,130,246,.16), rgba(19,19,21,.95)); box-shadow: 0 12px 30px rgba(0,0,0,.25); opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity .25s ease, transform .25s var(--ease), background .25s ease, color .25s ease; }
  .back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: none; }
  .back-to-top:hover { color: var(--ink); background: var(--gold-soft); transform: translateY(-4px); }
  .back-to-top span { font-size: 18px; line-height: 1; }
  @media (max-width: 820px) { .back-to-top { right: 18px; bottom: 170px; } }
  @media (max-width: 620px) { .back-to-top { right: 14px; bottom: 150px; width: 43px; height: 43px; } }
  @media (prefers-reduced-motion: reduce) { .back-to-top { transition-duration: .01ms; } }
</style>
<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
    window.__crestBackToTopCleanup?.();
    const controller = new AbortController();
    const backToTop = document.querySelector('[data-back-to-top]');
    const syncBackToTop = () => backToTop?.classList.toggle('is-visible', window.scrollY > 560);
    syncBackToTop();
    window.addEventListener('scroll', syncBackToTop, { passive: true, signal: controller.signal });
    backToTop?.addEventListener('click', () => { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); document.documentElement.scrollTop = 0; document.body.scrollTop = 0; syncBackToTop(); }, { signal: controller.signal });
    window.__crestBackToTopCleanup = () => controller.abort();
  })();
</script>
