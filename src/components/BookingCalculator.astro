---
import { allTreatments, ppfOptions, protectionAddOns, vehicleCategories } from '../data/catalog';
---
<section class="calculator-shell" id="booking-calculator">
  <form class="calculator-controls">
    <label>Vehicle category<select id="calc-category" required><option value="" selected disabled>Select your vehicle category</option>{vehicleCategories.map((category, index) => <option value={index}>{category}</option>)}</select></label>
    <label>Core treatment<select id="calc-service" required><option value="" selected disabled>Select a core service</option>{allTreatments.map((item) => <option value={item.number}>{item.number} — {item.title}</option>)}</select></label>
    <fieldset class="calc-addons"><legend>Optional add-ons</legend>
      <label class="calc-check"><input type="checkbox" id="calc-leather" /><span><strong>Leather seat polishing & conditioning</strong><small>Category-based price from treatment 08</small></span><b id="calc-leather-price">+ ₹500</b></label>
      <label class="calc-check"><input type="checkbox" id="calc-ppf" /><span><strong>PPF installation</strong><small>Select film and vehicle size below</small></span><b id="calc-ppf-price">+ ₹0</b></label>
      <div class="calc-dependent-fields" id="calc-ppf-fields"><label>PPF film<select id="calc-ppf-film">{ppfOptions.map((film) => <option value={film.name}>{film.name} · {film.warranty}</option>)}</select></label><label>PPF size<select id="calc-ppf-size"><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label></div>
      <label class="calc-check"><input type="checkbox" id="calc-exterior-ceramic" /><span><strong>Ceramic coating on PPF / glass / alloys</strong><small>Fixed application add-on from PDF</small></span><b>+ ₹20,000</b></label>
      <label class="calc-check"><input type="checkbox" id="calc-interior-ceramic" /><span><strong>Ceramic coating on interior & leather panels</strong><small>Protection and conditioning add-on</small></span><b>+ ₹10,000</b></label>
    </fieldset>
  </form>
  <aside class="calculator-summary"><div class="summary-kicker"><span></span> Your estimate</div><div class="calc-summary-lines"><div><span>Core treatment</span><strong id="calc-base">—</strong></div><div><span>Selected add-ons</span><strong id="calc-addons-total">—</strong></div><div><span>GST @ 18%</span><strong id="calc-gst">—</strong></div></div><div class="calc-breakdown" id="calc-breakdown">Choose a vehicle category and core service to see your estimate.</div><div class="calc-total"><span>Estimated total</span><strong id="calc-total">—</strong></div><p class="calc-source-note" id="calc-source-note">Final amount is confirmed by the Crest team after checking the car model and treatment availability.</p><a class="button button-gold" href="/contact" id="calc-cta">Use this estimate <span>↗</span></a></aside>
</section>
<script is:inline type="application/json" id="calculator-data" set:html={JSON.stringify({ treatments: allTreatments, ppf: ppfOptions, protectionAddOns, vehicleCategories })}></script>
<script is:inline data-astro-rerun>
  // @ts-nocheck
  (() => {
  const calculatorDataElement = document.querySelector('#calculator-data');
  const calculatorData = calculatorDataElement ? JSON.parse(calculatorDataElement.textContent || '{}') : null;
  const category = document.querySelector('#calc-category'); const service = document.querySelector('#calc-service'); const leather = document.querySelector('#calc-leather'); const ppf = document.querySelector('#calc-ppf'); const film = document.querySelector('#calc-ppf-film'); const size = document.querySelector('#calc-ppf-size'); const exterior = document.querySelector('#calc-exterior-ceramic'); const interior = document.querySelector('#calc-interior-ceramic');
  const output = { base: document.querySelector('#calc-base'), addons: document.querySelector('#calc-addons-total'), gst: document.querySelector('#calc-gst'), total: document.querySelector('#calc-total'), leather: document.querySelector('#calc-leather-price'), ppf: document.querySelector('#calc-ppf-price'), breakdown: document.querySelector('#calc-breakdown'), note: document.querySelector('#calc-source-note'), ppfFields: document.querySelector('#calc-ppf-fields') };
  const money = (value) => `₹${Math.round(value).toLocaleString('en-IN')}`;
  const number = (value) => Number(String(value).replace(/[^0-9]/g, '')) || 0;
  const update = () => { if (!calculatorData || !category?.value || !service?.value) { output.base.textContent = '—'; output.addons.textContent = '—'; output.gst.textContent = '—'; output.total.textContent = '—'; output.breakdown.textContent = 'Choose a vehicle category and core service to see your estimate.'; output.note.textContent = 'Select both fields above to calculate an indicative total. GST is added at 18%.'; output.ppfFields?.classList.remove('is-active'); window.__crestEstimate = null; return; } const index = Number(category.value); const treatment = calculatorData.treatments.find((item) => item.number === service.value) || calculatorData.treatments[0]; const leatherCost = leather.checked ? number(calculatorData.treatments.find((item) => item.number === '08').prices[index]) : 0; const selectedFilm = calculatorData.ppf.find((item) => item.name === film.value) || calculatorData.ppf[0]; const ppfCost = ppf.checked ? number(selectedFilm[size.value]) : 0; const exteriorCost = exterior.checked ? number(calculatorData.protectionAddOns[0].application) : 0; const interiorCost = interior.checked ? number(calculatorData.protectionAddOns[1].application) : 0; const base = number(treatment.prices[index]); const addons = leatherCost + ppfCost + exteriorCost + interiorCost; const subtotal = base + addons; const gst = Math.round(subtotal * .18); const total = subtotal + gst; const labels = [leatherCost && 'leather conditioning', ppfCost && `PPF · ${size.value}`, exteriorCost && 'exterior ceramic add-on', interiorCost && 'interior ceramic add-on'].filter(Boolean); output.base.textContent = money(base); output.addons.textContent = money(addons); output.gst.textContent = money(gst); output.total.textContent = money(total); output.leather.textContent = `+ ${money(number(calculatorData.treatments.find((item) => item.number === '08').prices[index]))}`; output.ppf.textContent = `+ ${money(ppfCost)}`; output.breakdown.textContent = `${treatment.title} · ${calculatorData.vehicleCategories[index]}${labels.length ? ` · ${labels.join(' · ')}` : ''}`; output.note.textContent = treatment.number === '14' && index === 2 ? 'Source note: the Premium sun-film price is shown exactly as listed in the supplied PDF (₹1,500). Please confirm before booking.' : `Final amount includes GST at 18% and is based on ${calculatorData.vehicleCategories[index]} resident pricing.`; output.ppfFields.classList.toggle('is-active', ppf.checked); window.__crestEstimate = { treatment, category: calculatorData.vehicleCategories[index], total, labels, ppfFilm: ppfCost ? selectedFilm.name : '', ppfSize: ppfCost ? size.value : '' }; };
  const requestedService = new URLSearchParams(window.location.search).get('service'); if (requestedService && [...service.options].some((option) => option.value === requestedService)) service.value = requestedService;
  [category, service, leather, ppf, film, size, exterior, interior].forEach((control) => control?.addEventListener('change', update)); update();
  document.querySelector('#calc-cta')?.addEventListener('click', (event) => { const estimate = window.__crestEstimate; if (!estimate) { event.preventDefault(); category?.focus(); return; } sessionStorage.setItem('crestEstimate', JSON.stringify(estimate)); });
  })();
</script>
<style>
  .calculator-shell { display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,.88fr); min-width: 0; border: 1px solid var(--line); background: #131315; }
  .calculator-controls { min-width: 0; padding: 30px; border-right: 1px solid var(--line); }
  .calculator-controls > label, .calc-dependent-fields > label { display: block; margin-bottom: 24px; color: #aab7c8; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .calculator-controls select, .calc-dependent-fields select { width: 100%; margin-top: 8px; padding: 14px 0; border: 0; border-bottom: 1px solid #52647b; border-radius: 0; color: var(--white); background: transparent; }
  .calc-addons { margin: 34px 0 0; padding: 0; border: 0; }
  .calc-addons legend { margin-bottom: 10px; color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .calc-check { display: grid; grid-template-columns: 18px 1fr auto; gap: 13px; align-items: center; padding: 16px 0; border-top: 1px solid var(--line); }
  .calc-check input { width: 16px; height: 16px; margin: 0; accent-color: var(--gold); }
  .calc-check span strong, .calc-check span small { display: block; }
  .calc-check span strong { color: var(--white); font-size: 12px; }
  .calc-check span small { margin-top: 4px; color: #8998ad; font-size: 11px; }
  .calc-check > b { color: var(--gold-soft); font-size: 10px; white-space: nowrap; }
  .calc-dependent-fields { display: none; grid-template-columns: 1.25fr .75fr; gap: 14px; margin: 2px 0 10px 31px; }
  .calc-dependent-fields.is-active { display: grid; }
  .calculator-summary { display: flex; min-width: 0; flex-direction: column; padding: 30px; background: linear-gradient(145deg, rgba(59,130,246,.15), rgba(255,255,255,.02)); }
  .summary-kicker { display: flex; gap: 10px; align-items: center; color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .summary-kicker span { width: 34px; height: 1px; background: var(--gold); }
  .calc-summary-lines { margin-top: 42px; border-top: 1px solid var(--line); }
  .calc-summary-lines > div { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .calc-summary-lines span, .calc-total span { color: #94a3b8; font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .calc-summary-lines strong { color: var(--white); font-size: 12px; }
  .calc-breakdown { min-height: 53px; margin-top: 23px; color: #a5b2c4; font-size: 12px; line-height: 1.65; }
  .calc-total { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-top: auto; padding-top: 24px; border-top: 1px solid rgba(59,130,246,.45); }
  .calc-total strong { color: var(--gold-soft); font-size: clamp(32px, 4vw, 48px); letter-spacing: -.07em; line-height: 1; }
  .calc-source-note { min-height: 56px; margin: 15px 0 25px; color: #8797aa; font-size: 11px; }
  .calculator-summary .button { width: 100%; max-width: 100%; }
  @media (max-width: 780px) { .calculator-shell { grid-template-columns: 1fr; } .calculator-controls { border-right: 0; border-bottom: 1px solid var(--line); padding: 23px 20px; } .calculator-summary { min-height: 420px; padding: 23px 20px; } .calc-dependent-fields { grid-template-columns: 1fr; margin-left: 31px; } }
</style>
