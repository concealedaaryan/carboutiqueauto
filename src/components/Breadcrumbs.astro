---
interface Item { label: string; href?: string; }
const { items = [] } = Astro.props as { items: Item[] };
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || '').replace(/\/$/, '');
const origin = siteUrl || Astro.url.origin;
const breadcrumbItems = [{ label: 'Home', href: '/' }, ...items];
const jsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbItems.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: `${origin}${item.href || Astro.url.pathname}` })) };
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<style>
  .breadcrumbs { display:flex; align-items:center; flex-wrap:wrap; gap:8px; max-width:var(--max); margin:0 auto; padding:18px 24px 0; color:var(--white); font-size:11px; }
  .breadcrumbs a { color:var(--white); }
  .breadcrumbs a:hover, .breadcrumbs [aria-current="page"] { color:var(--gold-soft); }
  .breadcrumbs span[aria-hidden="true"] { color:var(--gold); }
  @media (max-width:620px) { .breadcrumbs { padding:16px 20px 0; font-size:10px; } }
</style>
