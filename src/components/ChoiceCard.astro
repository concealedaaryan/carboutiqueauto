---
interface Props {
  number: string;
  title: string;
  copy: string;
  href: string;
  action: string;
  accent?: string;
}
const { number, title, copy, href, action, accent = 'Next step' } = Astro.props;
---
<a class="choice-card" href={href}>
  <span class="choice-number">{number}</span>
  <span class="choice-accent">{accent}</span>
  <strong>{title}</strong>
  <small>{copy}</small>
  <b>{action} <span aria-hidden="true">↗</span></b>
</a>
<style>
  .choice-card { display:flex; min-height:224px; flex-direction:column; padding:25px; border:1px solid var(--line); border-radius:2px; background:linear-gradient(145deg,rgba(226,185,104,.12),rgba(11,32,56,.9)); transition:transform .28s var(--ease),border-color .24s ease,box-shadow .24s ease; }
  .choice-card:hover, .choice-card:focus-visible { border-color:rgba(226,185,104,.8); transform:translateY(-5px); box-shadow:0 18px 44px rgba(0,0,0,.24); }
  .choice-number { color:var(--gold); font-size:10px; font-weight:700; letter-spacing:.12em; }
  .choice-accent { margin-top:24px; color:var(--gold-soft); font-size:9px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
  strong { margin-top:7px; color:var(--white); font-size:21px; letter-spacing:-.03em; }
  small { margin-top:7px; color:var(--white); font-size:13px; line-height:1.55; }
  b { display:inline-flex; gap:7px; align-items:center; margin-top:auto; padding-top:18px; color:var(--gold-soft); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
  .choice-card:hover b, .choice-card:focus-visible b { color:var(--white); }
</style>
