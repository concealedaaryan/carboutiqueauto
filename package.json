{
  "name": "crest-automotive-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:seo-security": "PUBLIC_SITE_URL=${PUBLIC_SITE_URL:-https://seo-check.example} pnpm build && PUBLIC_SITE_URL=${PUBLIC_SITE_URL:-https://seo-check.example} node scripts/check-seo-security.mjs"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
