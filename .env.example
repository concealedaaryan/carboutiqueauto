# Server-only secret used by api/chat.js for the Groq GPT-OSS 20B chatbot.
# Add the real value in Vercel Project Settings → Environment Variables.
# Never rename this to PUBLIC_GROQ_API_KEY and never commit a real secret.
GROQ_API_KEY=

# Public HTTPS domain used for canonical tags, social metadata, JSON-LD, and sitemap generation.
PUBLIC_SITE_URL=https://your-domain.example
